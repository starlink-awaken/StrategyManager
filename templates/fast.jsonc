{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "description": "速度优先型：高并发与快速响应，利用大带宽 API 提速",
  "metadata": {
    "version": "2.2.0",
    "updated": "2026-02-25",
    "cost_level": "high",
    "use_case": "高频对话、实时响应、需要极速反馈的场景",
    "optimization": "MiniMax M2.5 与 GLM-5 主力并发，Copilot 兜底复杂推理",
    "monthly_cost": "¥100-300 (大量使用已有订阅)",
    "resources_used": [
      "MiniMax Coding Plan Pro (M2.5 高速并发)",
      "ZhiPu CodingPlan Pro (GLM-5 大用量)",
      "GitHub Copilot Pro+",
      "DeepSeek API",
      "硅基流动",
      "方舟 CodingPlan Pro"
    ]
  },
  "lsp": {
    "scene_coverage": ["daily", "coding", "tools", "research", "creative", "writing"],
    "budget": {
      "monthlyLimitUSD": 100,
      "dailyAlertThreshold": 0.8,
      "emergencySwitchTo": "balanced"
    },
    "provider_quotas": {
      "minimax-cn-coding-plan": {
        "priority": 1,
        "maxRequestsPerDay": 50000,
        "maxConcurrentRequests": 40,
        "fallbackModels": ["zhipuai-coding-plan/glm-5", "github-copilot/gpt-4o"]
      },
      "zhipuai-coding-plan": {
        "priority": 1,
        "maxRequestsPerDay": 50000,
        "maxConcurrentRequests": 40,
        "fallbackModels": ["minimax-cn-coding-plan/MiniMax-M2.5", "ark/doubao-1.5-pro"]
      },
      "github-copilot": {
        "priority": 2,
        "maxRequestsPerDay": 100000,
        "maxConcurrentRequests": 50
      },
      "ark": {
        "priority": 3,
        "maxRequestsPerDay": 20000,
        "maxConcurrentRequests": 30
      },
      "deepseek": {
        "priority": 4,
        "maxRequestsPerDay": 10000,
        "maxCostPerRequest": 0.005,
        "maxConcurrentRequests": 20
      },
      "siliconflow": {
        "priority": 4,
        "maxRequestsPerDay": 10000,
        "maxCostPerRequest": 0.005,
        "maxConcurrentRequests": 20
      }
    },
    "constraints": {
      "maxToolsPerRequest": 12,
      "allowedTools": ["web_search", "file_io", "code_generation", "shell_execution", "data_processing", "git_operations"]
    }
  },
  "agents": {
    "sisyphus": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5",
      "fallback": ["zhipuai-coding-plan/glm-5", "ark/doubao-1.5-pro", "deepseek/deepseek-v3-2"],
      "temperature": 0.5,
      "maxTokens": 4000
    },
    "prometheus": {
      "model": "github-copilot/claude-sonnet-4.6",
      "thinking": {
        "type": "enabled",
        "budgetTokens": 50000
      },
      "temperature": 0.5,
      "maxTokens": 4000
    },
    "oracle": {
      "model": "github-copilot/gpt-5-mini",
      "temperature": 0.5,
      "maxTokens": 5000
    },
    "librarian": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5",
      "temperature": 0.5,
      "maxTokens": 4000
    },
    "explore": {
      "model": "zhipuai-coding-plan/glm-5",
      "temperature": 0.5,
      "maxTokens": 4000
    },
    "metis": {
      "model": "github-copilot/claude-sonnet-4.6",
      "thinking": {
        "type": "enabled",
        "budgetTokens": 40000
      },
      "temperature": 0.5,
      "maxTokens": 3000
    },
    "momus": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5",
      "temperature": 0.5,
      "maxTokens": 3000
    },
    "hephaestus": {
      "model": "zhipuai-coding-plan/glm-5",
      "temperature": 0.5,
      "maxTokens": 4000
    },
    "atlas": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5",
      "temperature": 0.5,
      "maxTokens": 4000
    },
    "multimodal-looker": {
      "model": "github-copilot/gpt-4o",
      "temperature": 0.5,
      "maxTokens": 3000
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "github-copilot/gpt-5-mini",
      "temperature": 0.5,
      "maxTokens": 4000
    },
    "ultrabrain": {
      "model": "github-copilot/claude-opus-4.6",
      "thinking": {
        "type": "enabled",
        "budgetTokens": 50000
      },
      "temperature": 0.5,
      "maxTokens": 5000
    },
    "artistry": {
      "model": "github-copilot/claude-sonnet-4.6",
      "temperature": 0.6,
      "maxTokens": 4500
    },
    "quick": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5",
      "temperature": 0.5,
      "maxTokens": 2000
    },
    "unspecified-low": {
      "model": "zhipuai-coding-plan/glm-5",
      "temperature": 0.5,
      "maxTokens": 2500
    },
    "unspecified-high": {
      "model": "github-copilot/claude-sonnet-4.6",
      "temperature": 0.5,
      "maxTokens": 5000
    },
    "writing": {
      "model": "ark/doubao-1.5-pro",
      "temperature": 0.5,
      "maxTokens": 4000
    },
    "deep": {
      "model": "github-copilot/claude-sonnet-4.6",
      "thinking": {
        "type": "enabled",
        "budgetTokens": 80000
      },
      "temperature": 0.5,
      "maxTokens": 6000
    }
  },
  "background_task": {
    "defaultConcurrency": 25,
    "staleTimeoutMs": 300000,
    "providerConcurrency": {
      "minimax-cn-coding-plan": 40,
      "zhipuai-coding-plan": 40,
      "github-copilot": 25,
      "ark": 20
    }
  },
  "sisyphus_agent": {
    "disabled": false,
    "default_builder_enabled": false,
    "planner_enabled": true,
    "replace_plan": true
  },
  "git_master": {
    "commit_footer": true,
    "include_co_authored_by": true
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  },
  "experimental": {
    "aggressive_truncation": false,
    "auto_resume": true,
    "truncate_all_tool_outputs": false
  },
  "disabled_mcps": [
    "github"
  ],
  "disabled_hooks": []
}