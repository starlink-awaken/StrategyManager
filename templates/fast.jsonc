{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "description": "速度优先型：低延迟高吞吐，优先快模型并保留多级兜底",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 2000
  },
  "metadata": {
    "version": "3.3.0",
    "updated": "2026-02-27",
    "cost_level": "medium-high",
    "use_case": "高频问答、并发子任务、快速迭代",
    "optimization": "Grok/Raptor/Gemini Flash 提速，Anthropic/OpenAI承接长上下文回退，国产模型承接并发峰值",
    "monthly_cost": "¥120-500",
    "resources_used": [
      "GitHub Copilot Pro+",
      "Google Pro Flash",
      "DeepSeek 余额池",
      "MiniMax/Kimi/ZhiPu/Bailian Pro"
    ]
  },
  "claude_code": {
    "skills": false,
    "mcp": false,
    "plugins": false,
    "hooks": false,
    "commands": false,
    "agents": false
  },
  "lsp": {
    "scene_coverage": [
      "daily",
      "coding",
      "tools",
      "research",
      "creative"
    ],
    "budget": {
      "monthlyLimitUSD": 500,
      "dailyAlertThreshold": 0.9,
      "emergencySwitchTo": "balanced"
    },
    "provider_quotas": {
      "github-copilot": {
        "priority": 1,
        "maxRequestsPerDay": 560,
        "maxConcurrentRequests": 22,
        "fallbackModels": [
          "github-copilot/grok-code-fast-1",
          "github-copilot/gpt-5.4-mini"
        ]
      },
      "google": {
        "priority": 1,
        "maxRequestsPerDay": 620,
        "maxConcurrentRequests": 20,
        "fallbackModels": [
          "google/antigravity-gemini-2.5-flash"
        ]
      },
      "anthropic": {
        "priority": 3,
        "maxRequestsPerDay": 180,
        "maxConcurrentRequests": 8,
        "fallbackModels": [
          "anthropic/claude-sonnet-4-6"
        ]
      },
      "openai": {
        "priority": 3,
        "maxRequestsPerDay": 180,
        "maxConcurrentRequests": 8,
        "fallbackModels": [
          "openai/gpt-5.4"
        ]
      },
      "deepseek": {
        "priority": 2,
        "maxRequestsPerDay": 460,
        "maxConcurrentRequests": 18,
        "fallbackModels": [
          "deepseek/deepseek-chat"
        ]
      },
      "zhipuai-coding-plan": {
        "priority": 2,
        "maxRequestsPerDay": 420,
        "maxConcurrentRequests": 16,
        "fallbackModels": [
          "zhipuai-coding-plan/glm-4.7-flash"
        ]
      },
      "minimax-coding-plan": {
        "priority": 2,
        "maxRequestsPerDay": 420,
        "maxConcurrentRequests": 18,
        "fallbackModels": [
          "minimax-coding-plan/MiniMax-M2.5"
        ]
      },
      "kimi-coding-plan": {
        "priority": 2,
        "maxRequestsPerDay": 420,
        "maxConcurrentRequests": 18,
        "fallbackModels": [
          "kimi-coding-plan/kimi-for-coding"
        ]
      },
      "volcegine-coding-plan": {
        "priority": 3,
        "maxRequestsPerDay": 340,
        "maxConcurrentRequests": 12,
        "fallbackModels": [
          "volcegine-coding-plan/doubao-seed-2-0-code-preview-latest"
        ]
      }
    },
    "constraints": {
      "maxToolsPerRequest": 18,
      "allowedTools": [
        "web_search",
        "file_io",
        "code_generation",
        "shell_execution",
        "data_processing",
        "git_operations"
      ]
    }
  },
  "agents": {
    "sisyphus": {
      "model": "github-copilot/grok-code-fast-1",
      "fallback": [
        "github-copilot/gpt-5.4-mini",
        "google/antigravity-gemini-2.5-flash",
        "minimax-coding-plan/MiniMax-M2.5",
        "zhipuai-coding-plan/glm-4.7-flash"
      ]
    },
    "sisyphus-junior": {
      "model": "github-copilot/gpt-5.4-mini",
      "fallback": [
        "deepseek/deepseek-chat",
        "zhipuai-coding-plan/glm-4.7-flash"
      ],
      "temperature": 0.2
    },
    "prometheus": {
      "model": "anthropic/claude-sonnet-4-6",
      "fallback": [
        "openai/gpt-5.4",
        "github-copilot/claude-sonnet-4.6"
      ]
    },
    "oracle": {
      "model": "google/antigravity-gemini-2.5-flash",
      "fallback": [
        "github-copilot/gpt-5.4-mini",
        "zhipuai-coding-plan/glm-5"
      ]
    },
    "librarian": {
      "model": "github-copilot/gpt-5.4-mini",
      "fallback": [
        "github-copilot/gpt-5.4"
      ]
    },
    "explore": {
      "model": "deepseek/deepseek-chat",
      "fallback": [
        "github-copilot/gpt-5.4-mini",
        "zhipuai-coding-plan/glm-4.7-flash"
      ]
    },
    "metis": {
      "model": "zhipuai-coding-plan/glm-4.7-flash",
      "fallback": [
        "minimax-coding-plan/MiniMax-M2.5"
      ]
    },
    "momus": {
      "model": "zhipuai-coding-plan/glm-4.7-flash",
      "fallback": [
        "volcegine-coding-plan/doubao-seed-2-0-code-preview-latest",
        "minimax-coding-plan/MiniMax-M2.5"
      ]
    },
    "hephaestus": {
      "model": "minimax-coding-plan/MiniMax-M2.5",
      "fallback": [
        "kimi-coding-plan/kimi-for-coding"
      ]
    },
    "atlas": {
      "model": "kimi-coding-plan/kimi-for-coding"
    },
    "multimodal-looker": {
      "model": "google/antigravity-gemini-2.5-flash",
      "fallback": [
        "github-copilot/gpt-5.4-mini"
      ]
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "google/antigravity-gemini-2.5-flash"
    },
    "ultrabrain": {
      "model": "github-copilot/grok-code-fast-1",
      "fallback": [
        "anthropic/claude-sonnet-4-6",
        "github-copilot/claude-sonnet-4.6"
      ]
    },
    "artistry": {
      "model": "google/antigravity-gemini-2.5-flash",
      "temperature": 0.7
    },
    "quick": {
      "model": "github-copilot/gpt-5.4-mini",
      "fallback": [
        "github-copilot/grok-code-fast-1"
      ]
    },
    "unspecified-low": {
      "model": "github-copilot/gpt-5.4-mini"
    },
    "unspecified-high": {
      "model": "github-copilot/gpt-5.4-mini",
      "fallback": [
        "zhipuai-coding-plan/glm-4.7"
      ]
    },
    "writing": {
      "model": "kimi-coding-plan/kimi-for-coding",
      "fallback": [
        "zhipuai-coding-plan/glm-5"
      ]
    },
    "deep": {
      "model": "deepseek/deepseek-reasoner",
      "fallback": [
        "anthropic/claude-sonnet-4-6",
        "zhipuai-coding-plan/glm-5"
      ]
    }
  }
}
