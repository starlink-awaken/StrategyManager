{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "description": "速度优先型：高并发与快速响应，利用大带宽 API 提速，适合碎片化与高频微调场景",
  "metadata": {
    "version": "3.0.0",
    "updated": "2026-02-25",
    "cost_level": "high",
    "use_case": "高频对话、实时响应、需要极速反馈的场景",
    "optimization": "Step/MiniMax/Kimi 主力极速并发，Copilot/Qwen 兜底",
    "monthly_cost": "¥100-300 (大量使用已有订阅)",
    "resources_used": [
      "Step 额度 (极速体验)",
      "MiniMax Coding Plan Pro (M2.5)",
      "Kimi Coding Plan Pro",
      "ZhiPu CodingPlan Pro (GLM-5)",
      "GitHub Copilot Pro+",
      "DashScope (Qwen)",
      "方舟 CodingPlan Pro"
    ]
  },
  "lsp": {
    "scene_coverage": ["daily", "coding", "tools", "research", "creative", "writing"],
    "budget": {
      "monthlyLimitUSD": 100,
      "dailyAlertThreshold": 0.8,
      "emergencySwitchTo": "balanced"
    },
    "provider_quotas": {
      "step": {
        "priority": 1,
        "maxRequestsPerDay": 50000,
        "maxConcurrentRequests": 50,
        "fallbackModels": ["minimax-cn-coding-plan/MiniMax-M2.5", "kimi/kimi-coding-pro"]
      },
      "minimax-cn-coding-plan": {
        "priority": 1,
        "maxRequestsPerDay": 50000,
        "maxConcurrentRequests": 40,
        "fallbackModels": ["kimi/kimi-coding-pro", "github-copilot/gpt-4o"]
      },
      "kimi": {
        "priority": 1,
        "maxRequestsPerDay": 50000,
        "maxConcurrentRequests": 40,
        "fallbackModels": ["minimax-cn-coding-plan/MiniMax-M2.5", "ark-cn/Doubao-Seed-2.0-Code"]
      },
      "zhipuai-coding-plan": {
        "priority": 2,
        "maxRequestsPerDay": 20000,
        "maxConcurrentRequests": 20,
        "fallbackModels": ["minimax-cn-coding-plan/MiniMax-M2.5", "ark-cn/Doubao-Seed-Code"]
      },
      "github-copilot": {
        "priority": 2,
        "maxRequestsPerDay": 100000,
        "maxConcurrentRequests": 50
      },
      "ark-cn": {
        "priority": 3,
        "maxRequestsPerDay": 20000,
        "maxConcurrentRequests": 30
      },
      "dashscope": {
        "priority": 3,
        "maxRequestsPerDay": 10000,
        "maxConcurrentRequests": 20
      },
      "deepseek": {
        "priority": 4,
        "maxRequestsPerDay": 10000,
        "maxCostPerRequest": 0.005,
        "maxConcurrentRequests": 20
      }
    },
    "constraints": {
      "maxToolsPerRequest": 12,
      "allowedTools": ["web_search", "file_io", "code_generation", "shell_execution", "data_processing", "git_operations"]
    }
  },
  "agents": {
    "sisyphus": {
      "model": "github-copilot/grok-code-fast-1",
      "fallback": ["minimax-cn-coding-plan/MiniMax-M2.5", "kimi/kimi-coding-pro", "ark-cn/Doubao-Seed-Code"],

      "fallback": ["minimax-cn-coding-plan/MiniMax-M2.5", "kimi/kimi-coding-pro", "ark-cn/Doubao-Seed-Code"],
      "temperature": 0.5,
      "maxTokens": 4000
    },
    "prometheus": {
      "model": "github-copilot/claude-3.5-sonnet",
      "thinking": {
        "type": "enabled",
        "budgetTokens": 50000
      },
      "temperature": 0.5,
      "maxTokens": 4000
    },
    "oracle": {
      "model": "dashscope/qwen-max-latest",
      "fallback": ["github-copilot/gpt-4o"],
      "temperature": 0.5,
      "maxTokens": 5000
    },
    "librarian": {
      "model": "github-copilot/grok-code-fast-1",
      "temperature": 0.5,
      "maxTokens": 4000
    },
    "explore": {
      "model": "github-copilot/grok-code-fast-1",
      "temperature": 0.5,
      "maxTokens": 4000
    },

      "temperature": 0.5,
      "maxTokens": 4000
    },
    "explore": {
      "model": "step/step-2-16k",
      "temperature": 0.5,
      "maxTokens": 4000
    },
    "metis": {
      "model": "kimi/kimi-coding-pro",
      "temperature": 0.5,
      "maxTokens": 3000
    },
    "momus": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5",
      "temperature": 0.5,
      "maxTokens": 3000
    },
    "hephaestus": {
      "model": "ark-cn/Doubao-Seed-Code",
      "temperature": 0.5,
      "maxTokens": 4000
    },
    "atlas": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5",
      "temperature": 0.5,
      "maxTokens": 4000
    },
    "multimodal-looker": {
      "model": "google/gemini-3.1-flash",
      "fallback": ["github-copilot/gpt-4o"],
      "temperature": 0.5,
      "maxTokens": 3000
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "step/step-2-16k",
      "temperature": 0.5,
      "maxTokens": 4000
    },
    "ultrabrain": {
      "model": "github-copilot/claude-3.5-sonnet",
      "temperature": 0.5,
      "maxTokens": 5000
    },
    "artistry": {
      "model": "google/gemini-3.1-flash",
      "temperature": 0.6,
      "maxTokens": 4500
    },
    "quick": {
      "model": "step/step-2-16k",
      "temperature": 0.5,
      "maxTokens": 2000
    },
    "unspecified-low": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5",
      "temperature": 0.5,
      "maxTokens": 2500
    },
    "unspecified-high": {
      "model": "kimi/kimi-coding-pro",
      "temperature": 0.5,
      "maxTokens": 5000
    },
    "writing": {
      "model": "ark-cn/Doubao-Seed-Code",
      "temperature": 0.5,
      "maxTokens": 4000
    },
    "deep": {
      "model": "github-copilot/claude-3.5-sonnet",
      "temperature": 0.5,
      "maxTokens": 6000
    }
  },
  "background_task": {
    "defaultConcurrency": 30,
    "staleTimeoutMs": 300000,
    "providerConcurrency": {
      "step": 50,
      "minimax-cn-coding-plan": 40,
      "kimi": 40,
      "zhipuai-coding-plan": 20,
      "github-copilot": 25,
      "ark-cn": 20
    }
  }
}