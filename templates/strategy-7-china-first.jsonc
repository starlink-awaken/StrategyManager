{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  // ============================================================
  // 策略 7: 国产优先 (China-First) 策略
  // 适用场景：国内网络环境优先，低延迟，充分利用国内订阅
  // 主力：方舟 CodingPlan + 智谱 + MiniMax (全订阅制)
  // 兜底：GitHub Copilot → API 额度 (DeepSeek/硅基/OpenRouter)
  // ============================================================
  "metadata": {
    "name": "国产优先 (China-First)",
    "version": "3.0.1",
    "description": "国内 AI 服务优先策略，最大化利用方舟/智谱/MiniMax 订阅，低延迟直连，Copilot 作为国际兜底。Zero-premium China-first strategy: all Copilot fallbacks use 0x models",
    "author": "strategy-manager",
    "updated": "2026-02-13",
    "cost_level": "low",
    "priority": "china-latency",
    "resources_used": [
      "方舟 CodingPlan Pro (季度订阅)",
      "智谱 Coding Plan Pro (年订阅, GLM-5 + GLM-4.5-air)",
      "MiniMax Coding Plan Pro (年订阅, M2.5 + M2.5-lightning)",
      "GitHub Copilot Pro+ (年订阅, 兜底)",
      "DeepSeek API ¥300 (最终兜底)",
      "硅基流动 ¥200 (最终兜底)",
      "OpenRouter $100 (最终兜底)"
    ],
    "rate_limits_note": "方舟 6000req/5h, 智谱 ~600/5h, MiniMax 300/5h, Copilot 无限"
  },
  "agents": {
    // sisyphus - 主执行者，高频任务，智谱主力（~600/5h 额度）
    "sisyphus": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "fallback": [
        "minimax-cn-coding-plan/MiniMax-M2.5",
        "github-copilot/gpt-4o"
      ]
    },
    // prometheus - 规划推理，需要强思考能力
    "prometheus": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "fallback": [
        "minimax-cn-coding-plan/MiniMax-M2.5",
        "github-copilot/gpt-4o"
      ]
    },
    // oracle - 顾问角色，需要多样化视角
    "oracle": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5",
      "fallback": ["zhipuai-coding-plan/glm-4.7", "github-copilot/gpt-4o"]
    },
    // hephaestus - 构建工具，高频工作，MiniMax 极速主力
    "hephaestus": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5-lightning",
      "fallback": ["zhipuai-coding-plan/glm-4.7-flash", "github-copilot/gpt-4o"]
    },
    // librarian - 文档检索，快速响应
    "librarian": {
      "model": "zhipuai-coding-plan/glm-4.7-flash",
      "fallback": [
        "minimax-cn-coding-plan/MiniMax-M2.5-lightning",
        "github-copilot/gpt-4o"
      ]
    },
    // explore - 代码探索，快速响应
    "explore": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5-lightning",
      "fallback": ["zhipuai-coding-plan/glm-4.7-flash", "github-copilot/gpt-4o"]
    },
    // multimodal - 多模态处理
    "multimodal-looker": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "fallback": ["github-copilot/gpt-4o"]
    },
    // metis - 元分析
    "metis": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "fallback": ["github-copilot/gpt-4o"]
    },
    // momus - 代码审查
    "momus": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5",
      "fallback": ["zhipuai-coding-plan/glm-4.7", "github-copilot/gpt-4o"]
    },
    // atlas - 快速探索，轻量任务
    "atlas": {
      "model": "zhipuai-coding-plan/glm-4.7-flash",
      "fallback": [
        "minimax-cn-coding-plan/MiniMax-M2.5-lightning",
        "github-copilot/gpt-4o"
      ]
    }
  },
  "categories": {
    // 视觉工程 - 智谱主力
    "visual-engineering": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "fallback": ["github-copilot/gpt-4o"]
    },
    // 超级推理 - MiniMax 推理
    "ultrabrain": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5",
      "fallback": ["zhipuai-coding-plan/glm-4.7", "deepseek/deepseek-v3-2"]
    },
    // 创意 - MiniMax
    "artistry": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5",
      "fallback": ["github-copilot/gpt-4o"]
    },
    // 创意 - MiniMax
    "artistry": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5",
      "fallback": ["github-copilot/gpt-4o"]
    },
    // 快速响应 - 智谱 Air 极速
    "quick": {
      "model": "zhipuai-coding-plan/glm-4.7-flash",
      "fallback": [
        "minimax-cn-coding-plan/MiniMax-M2.5-lightning",
        "github-copilot/gpt-4o"
      ]
    },
    // 通用低优先级 - 智谱 Air
    "unspecified-low": {
      "model": "zhipuai-coding-plan/glm-4.7-flash",
      "fallback": ["github-copilot/gpt-4o"]
    },
    // 通用高优先级 - 智谱旗舰
    "unspecified-high": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "fallback": [
        "minimax-cn-coding-plan/MiniMax-M2.5",
        "deepseek/deepseek-v3-2"
      ]
    },
    // 写作 - MiniMax
    "writing": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5",
      "fallback": ["github-copilot/gpt-4o"]
    },
    // 深度分析 - MiniMax 推理
    "deep": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5",
      "fallback": ["zhipuai-coding-plan/glm-4.7", "deepseek/deepseek-v3-2"]
    }
  },
  "background_task": {
    "defaultConcurrency": 5,
    "staleTimeoutMs": 300000,
    "providerConcurrency": {
      "zhipuai-coding-plan": 10,
      "minimax-cn-coding-plan": 10,
      "github-copilot": 5,
      "deepseek": 3,
      "siliconflow": 3,
      "openrouter": 3
    },
    "modelConcurrency": {
      "zhipuai-coding-plan/glm-4.7": 6,
      "zhipuai-coding-plan/glm-4.7-flash": 8,
      "minimax-cn-coding-plan/MiniMax-M2.5": 6,
      "minimax-cn-coding-plan/MiniMax-M2.5-lightning": 8,
      "github-copilot/gpt-4o": 5,
      "deepseek/deepseek-v3-2": 3,
      "siliconflow/deepseek-v3": 3,
      "openrouter/deepseek/deepseek-chat-v3": 3
    }
  },
  "sisyphus_agent": {
    "disabled": false,
    "default_builder_enabled": false,
    "planner_enabled": true,
    "replace_plan": true
  },
  "git_master": {
    "commit_footer": true,
    "include_co_authored_by": true
  },
  "tmux": {
    "enabled": true,
    "min_width": 200
  },
  "experimental": {
    "truncate_all": true
  },
  "disabled_mcps": ["github"],
  "disabled_hooks": []
}
