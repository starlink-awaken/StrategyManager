{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "description": "平衡型（Premium安全版）：近零Premium消耗，优先使用免费和低成本Copilot模型",
  "metadata": {
    "version": "3.0.0",
    "updated": "2026-02-10",
    "cost_level": "very-low",
    "use_case": "Premium额度紧张时的保守策略（<50 premium/month）",
    "optimization": "所有Copilot模型限制为0x/0.33x multiplier，月消耗<50 premium requests",
    "monthly_cost": "¥100-180",
    "resources_used": [
      "ZhiPu CodingPlan Max (60倍)",
      "方舟 CodingPlan Pro (20倍)",
      "Anthropic Pro（备用）",
      "Google Pro",
      "OpenAI Plus（备用）",
      "GitHub Copilot Pro+ (仅免费和0.33x模型)"
    ],
    "scene_coverage": "85%",
    "scene_mapping": {
      "个人项目开发": "visual-engineering (Copilot Codex)",
      "子女教育": "artistry (Copilot Haiku)",
      "公文处理": "quick (GPT-4o免费)",
      "健康管理": "deep (Copilot Haiku + thinking)",
      "AI项目探索": "visual-engineering + ultrabrain",
      "日常工具": "quick (免费)",
      "笔记管理": "unspecified-low (GLM高并发)",
      "娱乐": "quick (免费)",
      "常规写作": "writing (GPT-4o免费)",
      "多媒体创作": "artistry (Copilot Haiku)",
      "新媒体运营": "writing + artistry"
    }
  },
  // ================================================
  // Strategy-2: 平衡型 (BALANCED) - Premium安全版
  // ================================================
  "agents": {
    "sisyphus": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "temperature": 0.3,
      "maxTokens": 4000,
      "description": "用 ZhiPu 60倍额度作为主编排器"
    },
    "prometheus": {
      "model": "github-copilot/claude-haiku-4.5",
      "thinking": {
        "type": "enabled",
        "budgetTokens": 40000
      },
      "temperature": 0.2,
      "maxTokens": 4500,
      "description": "规划器（Premium安全版：Haiku 0.33x）"
    },
    "oracle": {
      "model": "github-copilot/gpt-5-mini",
      "fallback": "github-copilot/gpt-4o",
      "fallbackReason": "成本优化 - GPT-4o 免费兜底",
      "reasoningEffort": "medium",
      "temperature": 0.3,
      "maxTokens": 5000,
      "description": "关键架构决策（Copilot Codex）"
    },
    "hephaestus": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "temperature": 0.3,
      "maxTokens": 4000,
      "description": "深度工作用大额度"
    },
    "librarian": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "temperature": 0.1,
      "maxTokens": 2500,
      "description": "快速查询用大额度"
    },
    "explore": {
      "model": "anthropic/claude-haiku-4-5",
      "temperature": 0.2,
      "maxTokens": 2000,
      "description": "轻量级探索"
    },
    "multimodal-looker": {
      "model": "google/gemini-3-flash",
      "temperature": 0.3,
      "maxTokens": 3000,
      "description": "多模态用 Flash"
    },
    "metis": {
      "model": "github-copilot/claude-haiku-4.5",
      "thinking": {
        "type": "enabled",
        "budgetTokens": 40000
      },
      "fallback": "anthropic/claude-sonnet-4-5",
      "fallbackReason": "成本优化 - Anthropic Sonnet 兜底 (thinking 50k)",
      "temperature": 0.2,
      "maxTokens": 3500,
      "description": "规划前分析（Premium安全版：Haiku 0.33x）"
    },
    "momus": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "temperature": 0.2,
      "maxTokens": 3000,
      "description": "规划审查"
    },
    "atlas": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "temperature": 0.2,
      "maxTokens": 4000,
      "description": "执行器用大额度"
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "github-copilot/gpt-5-mini",
      "fallback": "github-copilot/gpt-4o",
      "fallbackReason": "成本优化 - GPT-4o 免费兜底",
      "reasoningEffort": "medium",
      "temperature": 0.3,
      "maxTokens": 4000,
      "description": "个人项目开发、AI探索 - 代码专精模型"
    },
    "ultrabrain": {
      "model": "github-copilot/claude-haiku-4.5",
      "variant": "max",
      "thinking": {
        "type": "enabled",
        "budgetTokens": 50000
      },
      "temperature": 0.2,
      "maxTokens": 5000,
      "description": "复杂架构决策（Premium安全版：Haiku 0.33x）"
    },
    "artistry": {
      "model": "github-copilot/claude-haiku-4.5",
      "fallback": "google/gemini-3-flash",
      "fallbackReason": "成本优化 - Flash 快速兜底",
      "temperature": 0.7,
      "maxTokens": 4500,
      "description": "子女教育、多媒体创作 - 温和耐心+创意",
      "systemPrompt": "在处理教育相关话题时，展现耐心和同理心，因材施教，关注心理健康。在创意内容时，发挥想象力和表达力。"
    },
    "quick": {
      "model": "github-copilot/gpt-4o",
      "temperature": 0.3,
      "maxTokens": 2000,
      "description": "公文处理、日常工具、娱乐 - 免费快速模型"
    },
    "unspecified-low": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "temperature": 0.3,
      "maxTokens": 2500,
      "description": "文件编辑、代码清理"
    },
    "unspecified-high": {
      "model": "github-copilot/gpt-4o",
      "thinking": {
        "type": "enabled",
        "budgetTokens": 50000
      },
      "temperature": 0.3,
      "maxTokens": 5000,
      "description": "复杂功能实现、架构设计"
    },
    "writing": {
      "model": "github-copilot/gpt-4o",
      "temperature": 0.6,
      "maxTokens": 4000,
      "description": "个人写作、新媒体、技术文章 - 专业文笔"
    },
    "deep": {
      "model": "github-copilot/claude-haiku-4.5",
      "thinking": {
        "type": "enabled",
        "budgetTokens": 50000
      },
      "fallback": "github-copilot/gpt-4o",
      "fallbackReason": "成本优化 - GPT-4o 免费兜底",
      "temperature": 0.2,
      "maxTokens": 6000,
      "description": "健康管理、深度分析、重要决策 - Premium安全版（Haiku 0.33x）",
      "systemPrompt": "在处理健康、金融等敏感领域时，务必：1) 明确你的局限性 2) 建议咨询专业人士 3) 提供多种可能性和风险评估 4) 保持审慎和负责的态度。"
    }
  },
  "background_task": {
    "defaultConcurrency": 12,
    "staleTimeoutMs": 300000,
    "providerConcurrency": {
      "anthropic": 2,
      "openai": 2,
      "google": 5,
      "zhipuai-coding-plan": 25,
      "ark-coding-plan": 10,
      "github-copilot": 12
    },
    "modelConcurrency": {
      "anthropic/claude-opus-4-6": 1,
      "anthropic/claude-sonnet-4-5": 2,
      "anthropic/claude-haiku-4-5": 4,
      "google/gemini-3-pro": 3,
      "google/gemini-3-flash": 10,
      "openai/gpt-5.3-codex": 2,
      "zhipuai-coding-plan/glm-4.7": 30,
      "github-copilot/claude-haiku-4.5": 8,
      "github-copilot/gpt-5.2-codex": 4,
      "github-copilot/gpt-4o": 15
    }
  },
  "sisyphus_agent": {
    "disabled": false,
    "default_builder_enabled": false,
    "planner_enabled": true,
    "replace_plan": true
  },
  "git_master": {
    "commit_footer": true,
    "include_co_authored_by": true
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  },
  "experimental": {
    "aggressive_truncation": false,
    "auto_resume": true,
    "truncate_all_tool_outputs": false
  },
  "disabled_mcps": [],
  "disabled_hooks": []
}
