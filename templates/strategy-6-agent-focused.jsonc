{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "description": "智能体任务专用策略: 多agent协作、代码生成、架构决策",
  "metadata": {
    "version": "1.1.0",
    "updated": "2026-02-08",
    "cost_level": "medium-high",
    "use_case": "智能体密集型任务:多agent协作、代码生成、架构决策",
    "optimization": "智能体专用: GPT-5.3-Codex/Mini 混合,GLM-4.7 大量兜底",
    "monthly_cost": "¥100-300",
    "scene_coverage": 75
  },
  "agents": {
    "sisyphus": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "variant": "max",
      "thinking": {
        "type": "enabled",
        "budgetTokens": 200000
      },
      "temperature": 0.3
    },
    "prometheus": {
      "model": "openai/gpt-5-mini",
      "fallback": "github-copilot/gpt-4o",
      "fallbackReason": "智能体任务优化 - GPT-4o/GLM-4.7 双层兜底",
      "temperature": 0.2
    },
    "oracle": {
      "model": "openai/gpt-5.3-codex",
      "fallback": "github-copilot/gpt-4o",
      "fallbackReason": "智能体任务优化 - GPT-4o/GLM-4.7 双层兜底",
      "reasoningEffort": "high",
      "temperature": 0.3
    },
    "hephaestus": {
      "model": "openai/gpt-5-mini",
      "fallback": "github-copilot/gpt-4o",
      "fallbackReason": "智能体任务优化 - GPT-4o/GLM-4.7 双层兜底",
      "temperature": 0.3
    },
    "librarian": {
      "model": "minimax-coding-plan/MiniMax-M2.1",
      "temperature": 0.2
    },
    "explore": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "temperature": 0.2
    },
    "multimodal-looker": {
      "model": "google/gemini-3-pro",
      "fallback": "google/gemini-3-flash",
      "fallbackReason": "极致稳定 - Gemini Flash 3 多模态互备",
      "variant": "high",
      "temperature": 0.3,
      "maxTokens": 4000
    },
    "metis": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "thinking": {
        "type": "enabled",
        "budgetTokens": 100000
      }
    },
    "momus": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "temperature": 0.3
    },
    "atlas": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "temperature": 0.3
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "openai/gpt-5-mini",
      "fallback": "github-copilot/gpt-4o",
      "fallbackReason": "智能体任务优化 - GPT-4o/GLM-4.7 双层兜底",
      "temperature": 0.4
    },
    "unspecified-high": {
      "model": "anthropic/claude-sonnet-4.5",
      "fallback": "github-copilot/gpt-4o",
      "fallbackReason": "智能体任务优化 - GPT-4o/GLM-4.7 双层兜底",
      "temperature": 0.3
    },
    "unspecified-low": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "temperature": 0.3
    },
    "quick": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "temperature": 0.3
    },
    "writing": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "temperature": 0.5
    },
    "artistry": {
      "model": "github-copilot/claude-sonnet-4.5",
      "temperature": 0.7
    },
    "ultrabrain": {
      "model": "openai/gpt-5-mini",
      "fallback": "github-copilot/claude-opus-4.6",
      "fallbackReason": "智能体任务优化 - Claude Opus/GLM-4.7 双层兜底",
      "temperature": 0.3
    },
    "deep": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "temperature": 0.2,
      "thinking": {
        "type": "enabled",
        "budgetTokens": 100000
      }
    }
  },
  "sisyphus_agent": {
    "disabled": false,
    "default_builder_enabled": false,
    "planner_enabled": true,
    "replace_plan": true
  },
  "git_master": {
    "commit_footer": true,
    "include_co_authored_by": true
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  },
  "experimental": {
    "aggressive_truncation": false,
    "auto_resume": true,
    "truncate_all_tool_outputs": false,
    "dynamic_context_pruning": {
      "enabled": false
    }
  },
  "disabled_mcps": [],

  "background_task": {
    "defaultConcurrency": 10,
    "staleTimeoutMs": 300000,
    "providerConcurrency": {
      "openai": 5,
      "zhipuai-coding-plan": 15,
      "github-copilot": 5
    },
    "modelConcurrency": {
      "openai/gpt-5.3-codex": 2,
      "openai/gpt-5-mini": 5,
      "zhipuai-coding-plan/glm-4.7": 20
    }
  }
}
