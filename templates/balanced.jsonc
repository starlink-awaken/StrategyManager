{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "description": "均衡型：日常主力，合理分配已订阅的 Pro 服务与免费额度，性价比与体验最优",
  "metadata": {
    "version": "3.1.0",
    "updated": "2026-02-25",
    "cost_level": "medium",
    "use_case": "默认日常策略（结合 Copilot、各种 Coding Plan 与充足的 Gemini 额度）",
    "optimization": "Copilot 核心 + Kimi/MiniMax/Ark/ZhiPu 大并发 + Gemini 充足额度支持创意/深度",
    "monthly_cost": "¥0-100 (主要消耗已有订阅，少部分 API 补足)",
    "resources_used": [
      "GitHub Copilot Pro+",
      "ZhiPu CodingPlan Pro",
      "MiniMax Coding Plan Pro",
      "Kimi Coding Plan Pro",
      "方舟 CodingPlan Pro (ark-cn)",
      "Google Pro (Gemini)",
      "DashScope (Qwen)",
      "DeepSeek API / 硅基流动"
    ]
  },
  "lsp": {
    "scene_coverage": ["daily", "coding", "tools", "finance", "general", "collaboration", "creative", "writing"],
    "budget": {
      "monthlyLimitUSD": 100,
      "dailyAlertThreshold": 0.8,
      "emergencySwitchTo": "cheap"
    },
    "provider_quotas": {
      "github-copilot": {
        "priority": 1,
        "maxRequestsPerDay": 20000,
        "maxConcurrentRequests": 20
      },
      "kimi": {
        "priority": 1,
        "maxRequestsPerDay": 20000,
        "maxConcurrentRequests": 30,
        "fallbackModels": ["minimax-cn-coding-plan/MiniMax-M2.5", "ark-cn/doubao-1.5-pro"]
      },
      "minimax-cn-coding-plan": {
        "priority": 1,
        "maxRequestsPerDay": 10000,
        "maxCostPerRequest": 0.005,
        "maxConcurrentRequests": 30,
        "fallbackModels": ["kimi/kimi-coding-pro", "ark-cn/doubao-1.5-pro"]
      },
      "ark-cn": {
        "priority": 2,
        "maxRequestsPerDay": 10000,
        "maxCostPerRequest": 0.005,
        "maxConcurrentRequests": 20,
        "fallbackModels": ["zhipuai-coding-plan/glm-5", "minimax-cn-coding-plan/MiniMax-M2.5"]
      },
      "zhipuai-coding-plan": {
        "priority": 2,
        "maxRequestsPerDay": 10000,
        "maxCostPerRequest": 0.005,
        "maxConcurrentRequests": 20,
        "fallbackModels": ["minimax-cn-coding-plan/MiniMax-M2.5", "ark-cn/doubao-1.5-pro"]
      },
      "google": {
        "priority": 1,
        "maxRequestsPerDay": 5000,
        "maxCostPerRequest": 0.02,
        "maxConcurrentRequests": 15
      },
      "dashscope": {
        "priority": 2,
        "maxRequestsPerDay": 5000,
        "maxCostPerRequest": 0.02,
        "maxConcurrentRequests": 10
      },
      "deepseek": {
        "priority": 3,
        "maxRequestsPerDay": 2000,
        "maxCostPerRequest": 0.01,
        "maxConcurrentRequests": 10
      },
      "siliconflow": {
        "priority": 3,
        "maxRequestsPerDay": 2000,
        "maxCostPerRequest": 0.01,
        "maxConcurrentRequests": 10
      }
    },
    "constraints": {
      "maxToolsPerRequest": 10,
      "allowedTools": ["web_search", "file_io", "code_generation", "shell_execution", "data_processing", "git_operations"]
    }
  },
  "agents": {
    "sisyphus": {
      "model": "github-copilot/gpt-4o",
      "fallback": ["kimi/kimi-coding-pro", "minimax-cn-coding-plan/MiniMax-M2.5", "ark-cn/doubao-1.5-pro", "deepseek/deepseek-v3-2"],
      "temperature": 0.5,
      "maxTokens": 4000
    },
    "prometheus": {
      "model": "github-copilot/claude-3.5-sonnet",
      "thinking": {
        "type": "enabled",
        "budgetTokens": 80000
      },
      "temperature": 0.5,
      "maxTokens": 4500
    },
    "oracle": {
      "model": "dashscope/qwen-max-latest",
      "fallback": ["github-copilot/gpt-4o", "ark-cn/doubao-1.5-pro"],
      "temperature": 0.5,
      "maxTokens": 5000
    },
    "hephaestus": {
      "model": "kimi/kimi-coding-pro",
      "temperature": 0.5,
      "maxTokens": 4000
    },
    "librarian": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5",
      "temperature": 0.5,
      "maxTokens": 4000
    },
    "explore": {
      "model": "ark-cn/doubao-1.5-pro",
      "temperature": 0.5,
      "maxTokens": 4000
    },
    "multimodal-looker": {
      "model": "google/gemini-2.5-pro",
      "fallback": ["github-copilot/gpt-4o"],
      "temperature": 0.5,
      "maxTokens": 4000
    },
    "metis": {
      "model": "google/gemini-2.5-pro",
      "thinking": {
        "type": "enabled",
        "budgetTokens": 40000
      },
      "temperature": 0.6,
      "maxTokens": 4000
    },
    "momus": {
      "model": "dashscope/qwen-max-latest",
      "temperature": 0.5,
      "maxTokens": 4000
    },
    "atlas": {
      "model": "kimi/kimi-coding-pro",
      "temperature": 0.5,
      "maxTokens": 4000
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "github-copilot/gpt-4o",
      "fallback": ["minimax-cn-coding-plan/MiniMax-M2.5"],
      "temperature": 0.5,
      "maxTokens": 4000
    },
    "ultrabrain": {
      "model": "google/gemini-2.5-pro",
      "thinking": {
        "type": "enabled",
        "budgetTokens": 80000
      },
      "temperature": 0.5,
      "maxTokens": 8000
    },
    "artistry": {
      "model": "google/gemini-2.5-pro",
      "fallback": ["ark-cn/doubao-1.5-pro", "kimi/kimi-coding-pro"],
      "temperature": 0.7,
      "maxTokens": 6000
    },
    "quick": {
      "model": "step/step-2-16k",
      "temperature": 0.5,
      "maxTokens": 2000
    },
    "unspecified-low": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5",
      "temperature": 0.5,
      "maxTokens": 2500
    },
    "unspecified-high": {
      "model": "github-copilot/claude-3.5-sonnet",
      "temperature": 0.5,
      "maxTokens": 5000
    },
    "writing": {
      "model": "google/gemini-2.5-pro",
      "fallback": ["kimi/kimi-coding-pro"],
      "temperature": 0.6,
      "maxTokens": 6000
    },
    "deep": {
      "model": "siliconflow/deepseek-ai/DeepSeek-R1",
      "fallback": ["google/gemini-2.5-pro"],
      "temperature": 0.6,
      "maxTokens": 8000
    }
  },
  "background_task": {
    "defaultConcurrency": 15,
    "staleTimeoutMs": 300000,
    "providerConcurrency": {
      "github-copilot": 15,
      "kimi": 20,
      "minimax-cn-coding-plan": 20,
      "ark-cn": 15,
      "zhipuai-coding-plan": 20,
      "google": 10,
      "deepseek": 5
    }
  }
}