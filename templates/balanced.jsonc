{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "description": "均衡型：默认主力策略，质量/速度/成本三方平衡并充分利用订阅资源",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 2000
  },
  "metadata": {
    "version": "3.3.0",
    "updated": "2026-02-27",
    "cost_level": "medium",
    "use_case": "日常开发、代码审查、写作、多任务并行",
    "optimization": "Copilot低倍率打底 + Anthropic/OpenAI/Google 承担中长上下文主线 + 国产Pro分担并发",
    "monthly_cost": "¥80-350 (主要消耗既有订阅)",
    "resources_used": [
      "GitHub Copilot Pro+",
      "Anthropic Pro",
      "ChatGPT Plus/Pro",
      "Google Pro (双账号)",
      "Kimi/MiniMax/ZhiPu/Bailian/Volcengine Pro",
      "DeepSeek 余额池"
    ]
  },
  "claude_code": {
    "skills": false,
    "mcp": false,
    "plugins": false,
    "hooks": false,
    "commands": false,
    "agents": false
  },
  "lsp": {
    "scene_coverage": [
      "daily",
      "coding",
      "tools",
      "finance",
      "creative",
      "writing",
      "research"
    ],
    "budget": {
      "monthlyLimitUSD": 400,
      "dailyAlertThreshold": 0.9,
      "emergencySwitchTo": "cheap"
    },
    "provider_quotas": {
      "github-copilot": {
        "priority": 1,
        "maxRequestsPerDay": 500,
        "maxConcurrentRequests": 18,
        "fallbackModels": [
          "github-copilot/gpt-4o",
          "github-copilot/gpt-4.1",
          "github-copilot/gpt-5-mini"
        ]
      },
      "anthropic": {
        "priority": 1,
        "maxRequestsPerDay": 360,
        "maxConcurrentRequests": 12,
        "fallbackModels": [
          "anthropic/claude-sonnet-4-6"
        ]
      },
      "openai": {
        "priority": 1,
        "maxRequestsPerDay": 360,
        "maxConcurrentRequests": 12,
        "fallbackModels": [
          "openai/gpt-5.3-codex",
          "openai/gpt-5.2-codex"
        ]
      },
      "google": {
        "priority": 1,
        "maxRequestsPerDay": 620,
        "maxConcurrentRequests": 20,
        "fallbackModels": [
          "google/antigravity-gemini-3.1-pro",
          "google/antigravity-gemini-3-flash"
        ]
      },
      "deepseek": {
        "priority": 2,
        "maxRequestsPerDay": 420,
        "maxConcurrentRequests": 16,
        "fallbackModels": [
          "deepseek/deepseek-reasoner",
          "deepseek/deepseek-chat"
        ]
      },
      "bailian-coding-plan": {
        "priority": 2,
        "maxRequestsPerDay": 420,
        "maxConcurrentRequests": 14,
        "fallbackModels": [
          "bailian-coding-plan/qwen3.5-plus"
        ]
      },
      "zhipuai-coding-plan": {
        "priority": 2,
        "maxRequestsPerDay": 440,
        "maxConcurrentRequests": 14,
        "fallbackModels": [
          "zhipuai-coding-plan/glm-5",
          "zhipuai-coding-plan/glm-4.7-flash"
        ]
      },
      "minimax-coding-plan": {
        "priority": 2,
        "maxRequestsPerDay": 420,
        "maxConcurrentRequests": 16,
        "fallbackModels": [
          "minimax-coding-plan/MiniMax-M2.5"
        ]
      },
      "kimi-coding-plan": {
        "priority": 2,
        "maxRequestsPerDay": 420,
        "maxConcurrentRequests": 16,
        "fallbackModels": [
          "kimi-coding-plan/kimi-for-coding"
        ]
      },
      "volcegine-coding-plan": {
        "priority": 3,
        "maxRequestsPerDay": 340,
        "maxConcurrentRequests": 12,
        "fallbackModels": [
          "volcegine-coding-plan/doubao-seed-2-0-code-preview-latest"
        ]
      }
    },
    "constraints": {
      "maxToolsPerRequest": 14,
      "allowedTools": [
        "web_search",
        "file_io",
        "code_generation",
        "shell_execution",
        "data_processing",
        "git_operations"
      ]
    }
  },
  "agents": {
    "sisyphus": {
      "model": "github-copilot/gpt-4o",
      "fallback": [
        "github-copilot/gpt-4.1",
        "minimax-coding-plan/MiniMax-M2.5",
        "kimi-coding-plan/kimi-for-coding",
        "zhipuai-coding-plan/glm-5"
      ],
      "temperature": 0.45
    },
    "sisyphus-junior": {
      "model": "github-copilot/gpt-4.1",
      "fallback": [
        "github-copilot/gpt-5-mini",
        "github-copilot/gpt-4o",
        "deepseek/deepseek-chat",
        "zhipuai-coding-plan/glm-4.7-flash"
      ],
      "temperature": 0.3
    },
    "prometheus": {
      "model": "anthropic/claude-sonnet-4-6",
      "fallback": [
        "openai/gpt-5.2-codex",
        "google/antigravity-claude-sonnet-4-6",
        "github-copilot/claude-sonnet-4.6"
      ],
      "thinking": {
        "type": "enabled",
        "budgetTokens": 40000
      }
    },
    "oracle": {
      "model": "google/antigravity-gemini-3.1-pro",
      "fallback": [
        "anthropic/claude-sonnet-4-6",
        "openai/gpt-5.2-codex",
        "bailian-coding-plan/qwen3.5-plus"
      ]
    },
    "hephaestus": {
      "model": "openai/gpt-5.3-codex",
      "fallback": [
        "github-copilot/gpt-5.2-codex",
        "github-copilot/gpt-4o",
        "anthropic/claude-sonnet-4-6"
      ]
    },
    "librarian": {
      "model": "kimi-coding-plan/kimi-for-coding",
      "fallback": [
        "zhipuai-coding-plan/glm-4.7"
      ]
    },
    "explore": {
      "model": "deepseek/deepseek-chat",
      "fallback": [
        "zhipuai-coding-plan/glm-4.7-flash",
        "github-copilot/gpt-4.1"
      ]
    },
    "multimodal-looker": {
      "model": "google/antigravity-gemini-3.1-pro",
      "fallback": [
        "google/antigravity-gemini-3-flash",
        "github-copilot/gpt-4o"
      ]
    },
    "metis": {
      "model": "deepseek/deepseek-reasoner",
      "fallback": [
        "anthropic/claude-sonnet-4-6",
        "zhipuai-coding-plan/glm-5"
      ]
    },
    "momus": {
      "model": "bailian-coding-plan/qwen3-coder-plus",
      "fallback": [
        "volcegine-coding-plan/doubao-seed-2-0-code-preview-latest",
        "github-copilot/gpt-4.1"
      ]
    },
    "atlas": {
      "model": "minimax-coding-plan/MiniMax-M2.5",
      "fallback": [
        "zhipuai-coding-plan/glm-4.7"
      ]
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "google/antigravity-gemini-3.1-pro",
      "fallback": [
        "github-copilot/gpt-4o"
      ]
    },
    "ultrabrain": {
      "model": "anthropic/claude-sonnet-4-6",
      "fallback": [
        "openai/gpt-5.3-codex"
      ]
    },
    "artistry": {
      "model": "google/antigravity-gemini-3.1-pro",
      "fallback": [
        "google/antigravity-gemini-3-flash"
      ],
      "temperature": 0.7
    },
    "quick": {
      "model": "github-copilot/gpt-5-mini",
      "fallback": [
        "github-copilot/gpt-4.1",
        "github-copilot/gpt-4o"
      ]
    },
    "unspecified-low": {
      "model": "github-copilot/gpt-4.1"
    },
    "unspecified-high": {
      "model": "anthropic/claude-sonnet-4-6",
      "fallback": [
        "openai/gpt-5.2-codex",
        "google/antigravity-gemini-3.1-pro",
        "github-copilot/claude-sonnet-4.6"
      ]
    },
    "writing": {
      "model": "google/antigravity-gemini-3.1-pro",
      "fallback": [
        "kimi-coding-plan/kimi-for-coding"
      ],
      "temperature": 0.6
    },
    "deep": {
      "model": "deepseek/deepseek-reasoner",
      "fallback": [
        "anthropic/claude-sonnet-4-6",
        "zhipuai-coding-plan/glm-5"
      ]
    }
  }
}
