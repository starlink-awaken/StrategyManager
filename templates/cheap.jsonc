{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "description": "经济型：低成本高可用，优先免费/低倍率资源并保留多平台回退",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 2000
  },
  "metadata": {
    "version": "3.3.0",
    "updated": "2026-02-27",
    "cost_level": "ultra-low",
    "use_case": "长时在线、批处理、低成本日常开发",
    "monthly_cost": "¥0-80 (主要消耗订阅与余额)",
    "resources_used": [
      "GitHub Copilot Pro+ 低倍率模型",
      "DeepSeek 余额池",
      "Kimi/MiniMax/ZhiPu/Bailian Pro",
      "Google Flash 兜底"
    ]
  },
  "claude_code": {
    "skills": false,
    "mcp": false,
    "plugins": false,
    "hooks": false,
    "commands": false,
    "agents": false
  },
  "lsp": {
    "scene_coverage": [
      "daily",
      "coding",
      "tools",
      "writing",
      "research"
    ],
    "budget": {
      "monthlyLimitUSD": 120,
      "dailyAlertThreshold": 0.92,
      "emergencySwitchTo": "balanced"
    },
    "provider_quotas": {
      "github-copilot": {
        "priority": 1,
        "maxRequestsPerDay": 420,
        "maxConcurrentRequests": 16,
        "fallbackModels": [
          "github-copilot/gpt-5.4-mini"
        ]
      },
      "deepseek": {
        "priority": 1,
        "maxRequestsPerDay": 420,
        "maxConcurrentRequests": 14,
        "fallbackModels": [
          "deepseek/deepseek-chat"
        ]
      },
      "zhipuai-coding-plan": {
        "priority": 2,
        "maxRequestsPerDay": 380,
        "maxConcurrentRequests": 14,
        "fallbackModels": [
          "zhipuai-coding-plan/glm-4.7-flash",
          "zhipuai-coding-plan/glm-4.7"
        ]
      },
      "minimax-coding-plan": {
        "priority": 2,
        "maxRequestsPerDay": 360,
        "maxConcurrentRequests": 16,
        "fallbackModels": [
          "minimax-coding-plan/MiniMax-M2.5"
        ]
      },
      "kimi-coding-plan": {
        "priority": 2,
        "maxRequestsPerDay": 360,
        "maxConcurrentRequests": 16,
        "fallbackModels": [
          "kimi-coding-plan/kimi-for-coding"
        ]
      },
      "google": {
        "priority": 3,
        "maxRequestsPerDay": 300,
        "maxConcurrentRequests": 10,
        "fallbackModels": [
          "google/antigravity-gemini-2.5-flash"
        ]
      }
    },
    "constraints": {
      "maxToolsPerRequest": 10,
      "allowedTools": [
        "web_search",
        "file_io",
        "code_generation",
        "shell_execution",
        "data_processing",
        "git_operations"
      ]
    }
  },
  "agents": {
    "sisyphus": {
      "model": "github-copilot/gpt-5.4-mini",
      "fallback": [
        "deepseek/deepseek-chat",
        "minimax-coding-plan/MiniMax-M2.5",
        "zhipuai-coding-plan/glm-4.7-flash"
      ],
      "temperature": 0.25
    },
    "sisyphus-junior": {
      "model": "github-copilot/gpt-5.4-mini",
      "fallback": [
        "deepseek/deepseek-chat",
        "zhipuai-coding-plan/glm-4.7-flash"
      ],
      "temperature": 0.2
    },
    "prometheus": {
      "model": "github-copilot/gpt-5.4-mini",
      "fallback": [
        "kimi-coding-plan/kimi-for-coding"
      ],
      "temperature": 0.2
    },
    "oracle": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "fallback": [
        "zhipuai-coding-plan/glm-5",
        "deepseek/deepseek-chat"
      ],
      "temperature": 0.3
    },
    "explore": {
      "model": "github-copilot/gpt-5.4-mini",
      "fallback": [
        "deepseek/deepseek-chat"
      ],
      "temperature": 0.3
    },
    "multimodal-looker": {
      "model": "google/antigravity-gemini-2.5-flash",
      "fallback": [
        "github-copilot/gpt-5.4-mini"
      ],
      "temperature": 0.4
    },
    "hephaestus": {
      "model": "minimax-coding-plan/MiniMax-M2.5",
      "fallback": [
        "kimi-coding-plan/kimi-for-coding",
        "zhipuai-coding-plan/glm-4.7"
      ]
    },
    "librarian": {
      "model": "github-copilot/gpt-5.4-mini",
      "fallback": [
        "zhipuai-coding-plan/glm-4.7-flash"
      ]
    },
    "metis": {
      "model": "deepseek/deepseek-reasoner",
      "fallback": [
        "zhipuai-coding-plan/glm-5",
        "github-copilot/gpt-5.4-mini"
      ]
    },
    "momus": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "fallback": [
        "minimax-coding-plan/MiniMax-M2.5",
        "kimi-coding-plan/kimi-for-coding"
      ]
    },
    "atlas": {
      "model": "kimi-coding-plan/kimi-for-coding"
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "google/antigravity-gemini-2.5-flash"
    },
    "ultrabrain": {
      "model": "github-copilot/gpt-5.4-mini",
      "fallback": [
        "zhipuai-coding-plan/glm-5"
      ]
    },
    "deep": {
      "model": "deepseek/deepseek-reasoner",
      "fallback": [
        "zhipuai-coding-plan/glm-5"
      ]
    },
    "quick": {
      "model": "github-copilot/gpt-5.4-mini",
      "fallback": [
        "zhipuai-coding-plan/glm-4.7"
      ]
    },
    "unspecified-low": {
      "model": "github-copilot/gpt-5.4-mini"
    },
    "unspecified-high": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "fallback": [
        "minimax-coding-plan/MiniMax-M2.5"
      ]
    },
    "writing": {
      "model": "kimi-coding-plan/kimi-for-coding",
      "fallback": [
        "zhipuai-coding-plan/glm-5"
      ]
    },
    "artistry": {
      "model": "google/antigravity-gemini-2.5-flash"
    }
  }
}
