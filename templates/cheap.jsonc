{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "description": "经济型：最大化已订阅的 Coding Plan 与免费额度，结合新补充模型，适合大批量处理",
  "metadata": {
    "version": "2.1.0",
    "updated": "2026-02-25",
    "cost_level": "ultra-low",
    "use_case": "探索、学习、快速迭代、重度使用且希望零额外成本",
    "monthly_cost": "¥0 (仅消耗已购订阅)",
    "resources_used": [
      "GitHub Copilot Pro+",
      "ZhiPu CodingPlan Pro",
      "MiniMax Coding Plan Pro",
      "Kimi Coding Plan Pro",
      "方舟 CodingPlan Pro (ark-cn)",
      "Step 额度",
      "DeepSeek / 硅基流动"
    ]
  },
  "lsp": {
    "scene_coverage": ["daily", "tools", "education", "health", "entertainment", "chinese"],
    "budget": {
      "monthlyLimitUSD": 50,
      "dailyAlertThreshold": 0.8,
      "emergencySwitchTo": "cheap"
    },
    "provider_quotas": {
      "minimax-cn-coding-plan": {
        "priority": 1,
        "maxRequestsPerDay": 50000,
        "maxConcurrentRequests": 30,
        "fallbackModels": ["kimi/kimi-coding-pro", "ark-cn/Doubao-Seed-2.0-Code"]
      },
      "kimi": {
        "priority": 1,
        "maxRequestsPerDay": 50000,
        "maxConcurrentRequests": 30,
        "fallbackModels": ["minimax-cn-coding-plan/MiniMax-M2.5", "ark-cn/Doubao-Seed-Code"]
      },
      "zhipuai-coding-plan": {
        "priority": 2,
        "maxRequestsPerDay": 20000,
        "maxConcurrentRequests": 20,
        "fallbackModels": ["minimax-cn-coding-plan/MiniMax-M2.5", "ark-cn/Doubao-Seed-Code"]
      },
      "ark-cn": {
        "priority": 1,
        "maxRequestsPerDay": 30000,
        "maxConcurrentRequests": 20,
        "fallbackModels": ["zhipuai-coding-plan/glm-4.7", "minimax-cn-coding-plan/MiniMax-M2.5"]
      },
      "step": {
        "priority": 3,
        "maxRequestsPerDay": 10000,
        "maxCostPerRequest": 0.005,
        "maxConcurrentRequests": 30
      },
      "dashscope": {
        "priority": 3,
        "maxRequestsPerDay": 10000,
        "maxConcurrentRequests": 20
      },
      "github-copilot": {
        "priority": 2,
        "maxRequestsPerDay": 100000,
        "maxConcurrentRequests": 50
      },
      "deepseek": {
        "priority": 3,
        "maxRequestsPerDay": 10000,
        "maxCostPerRequest": 0.002,
        "maxConcurrentRequests": 20
      },
      "siliconflow": {
        "priority": 3,
        "maxRequestsPerDay": 10000,
        "maxCostPerRequest": 0.002,
        "maxConcurrentRequests": 20
      }
    },
    "constraints": {
      "maxToolsPerRequest": 6,
      "allowedTools": ["web_search", "file_io", "code_generation", "shell_execution", "data_processing"]
    }
  },
  "agents": {
    "sisyphus": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5",
      "fallback": ["kimi/kimi-coding-pro", "ark-cn/Doubao-Seed-Code", "github-copilot/gpt-4o"],
      "temperature": 0.3
    },
    "prometheus": {
      "model": "kimi/kimi-coding-pro",
      "tools": ["read", "write", "edit", "bash", "grep", "task"],
      "temperature": 0.2
    },
    "oracle": {
      "model": "ark-cn/Doubao-Seed-Code",
      "fallback": ["dashscope/qwen2.5-coder-32b-instruct", "zhipuai-coding-plan/glm-4.7"],
      "temperature": 0.3
    },
    "explore": {
      "model": "step/step-2-16k",
      "fallback": ["minimax-cn-coding-plan/MiniMax-M2.5"],
      "temperature": 0.3
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5",
      "temperature": 0.4
    },
    "ultrabrain": {
      "model": "kimi/kimi-coding-pro",
      "tools": ["read", "write", "edit", "bash", "grep", "task"],
      "temperature": 0.2
    },
    "deep": {
      "model": "dashscope/qwen-max-latest",
      "fallback": ["ark-cn/Doubao-Seed-Code"]
    },
    "quick": {
      "model": "step/step-2-16k",
      "fallback": ["github-copilot/gpt-4o"],
      "temperature": 0.3
    },
    "unspecified-low": {
      "model": "github-copilot/raptor-mini",
      "temperature": 0.3
    },

    "unspecified-high": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5",
      "temperature": 0.3
    },
    "writing": {
      "model": "kimi/kimi-coding-pro",
      "fallback": ["ark-cn/Doubao-Seed-Code"]
    },
    "artistry": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5"
    }
  }
}