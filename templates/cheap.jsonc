{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "description": "经济型：最大化已订阅的 Coding Plan 与免费额度，适合大批量处理",
  "metadata": {
    "version": "2.0.0",
    "updated": "2026-02-25",
    "cost_level": "ultra-low",
    "use_case": "探索、学习、快速迭代、重度使用且希望零额外成本",
    "monthly_cost": "¥0 (仅消耗已购订阅)",
    "resources_used": [
      "GitHub Copilot Pro+ (无限量)",
      "ZhiPu CodingPlan Pro (年付订阅)",
      "MiniMax Coding Plan Pro (年付订阅)",
      "方舟 CodingPlan Pro (季付订阅)",
      "DeepSeek (¥300 额度)",
      "硅基流动 (¥200 额度)"
    ]
  },
  "lsp": {
    "scene_coverage": ["daily", "tools", "education", "health", "entertainment", "chinese"],
    "budget": {
      "monthlyLimitUSD": 50,
      "dailyAlertThreshold": 0.8,
      "emergencySwitchTo": "cheap"
    },
    "provider_quotas": {
      "zhipuai-coding-plan": {
        "priority": 1,
        "maxRequestsPerDay": 50000,
        "maxConcurrentRequests": 40,
        "fallbackModels": ["minimax-cn-coding-plan/MiniMax-M2.5", "ark/doubao-1.5-pro"]
      },
      "minimax-cn-coding-plan": {
        "priority": 1,
        "maxRequestsPerDay": 50000,
        "maxConcurrentRequests": 30,
        "fallbackModels": ["zhipuai-coding-plan/glm-4.7", "ark/doubao-1.5-pro"]
      },
      "ark": {
        "priority": 1,
        "maxRequestsPerDay": 30000,
        "maxConcurrentRequests": 20,
        "fallbackModels": ["zhipuai-coding-plan/glm-4.7", "minimax-cn-coding-plan/MiniMax-M2.5"]
      },
      "github-copilot": {
        "priority": 2,
        "maxRequestsPerDay": 100000,
        "maxConcurrentRequests": 50
      },
      "deepseek": {
        "priority": 3,
        "maxRequestsPerDay": 10000,
        "maxCostPerRequest": 0.002,
        "maxConcurrentRequests": 20
      },
      "siliconflow": {
        "priority": 3,
        "maxRequestsPerDay": 10000,
        "maxCostPerRequest": 0.002,
        "maxConcurrentRequests": 20
      }
    },
    "constraints": {
      "maxToolsPerRequest": 6,
      "allowedTools": ["web_search", "file_io", "code_generation", "shell_execution", "data_processing"]
    }
  },
  "agents": {
    "sisyphus": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5",
      "fallback": ["zhipuai-coding-plan/glm-4.7", "ark/doubao-1.5-pro", "github-copilot/gpt-4o"],
      "temperature": 0.3
    },
    "prometheus": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "tools": ["read", "write", "edit", "bash", "grep", "task"],
      "temperature": 0.2
    },
    "oracle": {
      "model": "ark/doubao-1.5-pro",
      "fallback": ["github-copilot/gpt-5-mini", "deepseek/deepseek-v3-2"],
      "temperature": 0.3
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5",
      "temperature": 0.4
    },
    "ultrabrain": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "tools": ["read", "write", "edit", "bash", "grep", "task"],
      "temperature": 0.2
    },
    "deep": {
      "model": "ark/doubao-1.5-pro"
    },
    "quick": {
      "model": "github-copilot/gpt-4o",
      "temperature": 0.3
    },
    "unspecified-low": {
      "model": "github-copilot/gpt-4o",
      "temperature": 0.3
    },
    "unspecified-high": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5",
      "temperature": 0.3
    },
    "writing": {
      "model": "ark/doubao-1.5-pro"
    },
    "artistry": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5"
    }
  }
}