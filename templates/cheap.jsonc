{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "description": "经济型：最大化免费额度，批量处理优先",
  "metadata": {
    "version": "1.1.1",
    "updated": "2026-02-13",
    "cost_level": "ultra-low",
    "use_case": "探索、学习、快速迭代、成本压力大",
    "monthly_cost": "¥50-150",
    "resources_used": [
      "GitHub Copilot Pro+ (免费模型)",
      "ZhiPu CodingPlan Max (额度)",
      "DeepSeek (额度)",
      "硅基流动 (额度)",
      "Google Pro (Gemini Flash 便宜)"
    ]
  },
  "lsp": {
    "scene_coverage": ["daily", "tools", "education", "health", "entertainment", "chinese"],
    "budget": {
      "monthlyLimitUSD": 150,
      "dailyAlertThreshold": 0.8,
      "emergencySwitchTo": "cheap"
    },
    "provider_quotas": {
      "kimi": {
        "priority": 1,
        "maxRequestsPerDay": 20000,
        "maxCostPerRequest": 0.01,
        "maxConcurrentRequests": 30,
        "fallbackModels": ["step/step-3-flash", "zhipuai/glm-4.7-flash"]
      },
      "step": {
        "priority": 1,
        "maxRequestsPerDay": 20000,
        "maxCostPerRequest": 0.01,
        "maxConcurrentRequests": 30,
        "fallbackModels": ["kimi/kimi-coding-pro", "zhipuai/glm-4.7-flash"]
      },
      "zhipuai": {
        "priority": 2,
        "maxRequestsPerDay": 50000,
        "maxCostPerRequest": 0.005,
        "maxConcurrentRequests": 40,
        "fallbackModels": ["kimi/kimi-coding-pro", "step/step-3-flash"]
      },
      "minimax": {
        "priority": 2,
        "maxRequestsPerDay": 20000,
        "maxCostPerRequest": 0.005,
        "maxConcurrentRequests": 20
      },
      "deepseek": {
        "priority": 3,
        "maxRequestsPerDay": 50000,
        "maxCostPerRequest": 0.002,
        "maxConcurrentRequests": 50
      },
      "github-copilot": {
        "priority": 1,
        "maxRequestsPerDay": 100000,
        "maxConcurrentRequests": 100
      }
    },
    "constraints": {
      "maxToolsPerRequest": 6,
      "allowedTools": ["web_search", "file_io", "code_generation", "shell_execution", "data_processing"]
    }
  },
  "agents": {
    "sisyphus": {
      "model": "github-copilot/gpt-4o",
      "fallback": ["deepseek/deepseek-v3-2", "siliconflow/deepseek-v3", "openrouter/deepseek/deepseek-chat-v3"],
      "temperature": 0.3
    },
    "prometheus": {
      "model": "github-copilot/gpt-5-mini",
      "tools": ["read", "write", "edit", "bash", "grep", "task"],
      "temperature": 0.2
    },
    "oracle": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "temperature": 0.3
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "google/gemini-3-flash-preview",
      "temperature": 0.4
    },
    "ultrabrain": {
      "model": "github-copilot/gpt-5-mini",
      "tools": ["read", "write", "edit", "bash", "grep", "task"],
      "temperature": 0.2
    },
    "deep": {
      "model": "github-copilot/gpt-5-mini"
    },
    "quick": {
      "model": "github-copilot/gpt-5-mini",
      "temperature": 0.3
    },
    "unspecified-low": {
      "model": "github-copilot/gpt-4o",
      "temperature": 0.3
    },
    "unspecified-high": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "temperature": 0.3
    },
    "writing": {
      "model": "google/gemini-3-flash-preview"
    },
    "artistry": {
      "model": "google/gemini-3-flash-preview"
    }
  }
}