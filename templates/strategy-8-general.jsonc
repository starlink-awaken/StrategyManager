{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "description": "通用型：日常工作全覆盖，经济实用，强度适中",
  "metadata": {
    "version": "1.0.0",
    "created": "2026-02-19",
    "updated": "2026-02-19",
    "cost_level": "low",
    "use_case": "日常个人工作、学习、生活助手 - 覆盖90%常见场景",
    "optimization": "经济实用 + 持久稳定 - 以免费/低成本资源为主，付费资源为辅",
    "monthly_cost": "¥80-180",
    "usage_frequency": "高频（每周5-10天，每天1-4小时）",
    "resources_used": [
      "ZhiPu CodingPlan (GLM-5 免费额度)",
      "GitHub Copilot (免费模型：GPT-4o, GPT-5-mini)",
      "DeepSeek 预算（低成本兜底）",
      "Google 免费额度（Gemini Flash）",
      "MiniMax 预度（低成本补充）",
      "Anthropic Pro (低频重要场景：Haiku 快速) ",
      "OpenAI Codex (低频重要场景：GPT-5.3 高级推理）"
    ],
    "scene_coverage": "90%",
    "scene_mapping": {
      "代码开发": "visual-engineering (ZhiPu 主力 + Copilot 兜底)",
      "规划决策": "ultrabrain (MiniMax 思考 + DeepSeek 兜底)",
      "文档写作": "writing (ZhiPu + Gemini Flash + Copilot Haiku)",
      "快速查询": "quick (Gemini Flash 免费快速 + Copilot Haiku)",
      "创意内容": "artistry (ZhiPu + MiniMax + Copilot Haiku)",
      "学习笔记": "unspecified-low (ZhiPu 高并发 + Gemini Flash)",
      "健康咨询": "deep (MiniMax 专业 + ZhiPu 兜底)",
      "日常工具": "quick (Gemini Flash 快速 + Copilot Haiku)",
      "重要决策": "unspecified-high (MiniMax + Anthropic Haiku 兜底) ",
      "深度推理": "deep (MiniMax + Codex 兜底)"
    }
  },
  // ================================================
  // Strategy-3: 通用型 (GENERAL)
  // ================================================
  // 理念：经济实用 + 持久稳定，以免费/低成本资源为主
  // 特点：强度适中，每周可不间断工作，覆盖日常90%场景
  // 适用场景：日常个人工作、学习、生活助手
  // ================================================
  "agents": {
    // 主执行器 - 智谱 GLM-5 免费额度主力
    "sisyphus": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "tools": ["read", "write", "edit", "bash", "grep", "task"],
      "fallback": ["github-copilot/gpt-4o", "github-copilot/gpt-5-mini", "ark/glm-5", "siliconflow/deepseek-v3", "openrouter/deepseek/deepseek-chat-v3"],
      "fallbackReason": "成本优化 - GPT-4o/GPT-5-mini 免费兜底",
      "temperature": 0.3,
      "maxTokens": 4000,
      "description": "主编排器：智谱免费额度主力，Copilot 免费兜底"
    },
    // 规划器 - MiniMax 思考能力
    "prometheus": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5",
      "fallback": ["deepseek/deepseek-v3-2", "openai/gpt-5.3-codex"],
      "fallbackReason": "成本优化 - DeepSeek/Codex 低成本兜底",
      "temperature": 0.2,
      "maxTokens": 5000,
      "description": "规划器：MiniMax 思考 + DeepSeek/Codex 兜底"
    },
    // 顾问 - ZhiPu 多样化视角
    "oracle": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "fallback": [
        "minimax-cn-coding-plan/MiniMax-M2.5",
        "anthropic/claude-haiku-4-5"
      ],
      "fallbackReason": "成本优化 - Anthropic Haiku 快速兜底",
      "temperature": 0.3,
      "maxTokens": 5000,
      "description": "顾问：智谱为主，MiniMax/Haiku 兜底"
    },
    // 构建工具 - ZhiPu + Copilot 免费
    "hephaestus": {
      "model": "zhipuai-coding-plan/glm-4.7-flash",
      "fallback": "github-copilot/gpt-4o",
      "temperature": 0.2,
      "maxTokens": 3000,
      "description": "构建工具：智谱极速 + Copilot 免费兜底"
    },
    // 多模态 - ZhiPu 视觉能力
    "multimodal-looker": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "fallback": "github-copilot/gpt-4o",
      "temperature": 0.3,
      "maxTokens": 4000,
      "description": "多模态：智谱视觉 + Copilot 兜底"
    },
    // 元分析 - MiniMax 推理
    "metis": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5",
      "fallback": "zhipuai-coding-plan/glm-4.7",
      "temperature": 0.2,
      "maxTokens": 4000,
      "description": "元分析：MiniMax 推理 + 智谱兜底"
    },
    // 代码审查 - MiniMax + ZhiPu
    "momus": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5",
      "fallback": "zhipuai-coding-plan/glm-4.7",
      "temperature": 0.2,
      "maxTokens": 4500,
      "description": "审查员：MiniMax 质量 + 智谱兜底"
    },
    // 探索 - Gemini Flash 极速免费
    "atlas": {
      "model": "google/gemini-3-flash-preview",
      "fallback": [
        "github-copilot/claude-haiku-4.5",
        "zhipuai-coding-plan/glm-4.7-flash"
      ],
      "fallbackReason": "Haiku 免费快速 + 智谱极速兜底",
      "temperature": 0.3,
      "maxTokens": 2000,
      "description": "探索者：Gemini Flash 免费快速 + Haiku/智谱兜底"
    }
  },
  "categories": {
    // 代码开发 - 智谱主力 + Copilot 兜底
    "visual-engineering": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "fallback": [
        "github-copilot/gpt-4o",
        "minimax-cn-coding-plan/MiniMax-M2.5"
      ]
    },
    // 超级推理 - MiniMax 思考 + DeepSeek 兜底
    "ultrabrain": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5",
      "fallback": ["deepseek/deepseek-v3-2", "zhipuai-coding-plan/glm-4.7"]
    },
    // 创意 - ZhiPu + MiniMax
    "artistry": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "fallback": [
        "minimax-cn-coding-plan/MiniMax-M2.5",
        "google/gemini-3-flash-preview",
        "github-copilot/claude-haiku-4.5"
      ]
    },
    // 快速响应 - Gemini Flash 免费快速
    "quick": {
      "model": "google/gemini-3-flash-preview",
      "fallback": [
        "github-copilot/claude-haiku-4.5",
        "zhipuai-coding-plan/glm-4.7-flash",
        "github-copilot/gpt-4o"
      ]
    },
    // 通用低优先级 - 智谱高并发
    "unspecified-low": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "tools": ["read", "write", "edit", "bash", "grep", "task"],
      "fallback": [
        "zhipuai-coding-plan/glm-4.7-flash",
        "google/gemini-3-flash-preview",
        "github-copilot/gpt-5-mini"
      ]
    },
    // 通用高优先级 - MiniMax + ZhiPu
    "unspecified-high": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5",
      "fallback": ["zhipuai-coding-plan/glm-4.7", "deepseek/deepseek-v3-2"]
    },
    // 写作 - ZhiPu + Gemini Flash
    "writing": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "fallback": [
        "google/gemini-3-flash-preview",
        "github-copilot/gpt-4o",
        "github-copilot/claude-haiku-4.5"
      ]
    },
    // 深度分析 - MiniMax 专业 + ZhiPu 兜底
    "deep": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5",
      "fallback": [
        "zhipuai-coding-plan/glm-4.7",
        "deepseek/deepseek-v3-2",
        "openai/gpt-5.3-codex"
      ]
    }
  },
  // 并发配置：强度适中，每周可不间断工作
  "background_task": {
    "defaultConcurrency": 8,
    "staleTimeoutMs": 300000,
    "providerConcurrency": {
      "zhipuai-coding-plan": 20,
      "google": 8,
      "minimax-cn-coding-plan": 6,
      "github-copilot": 8,
      "deepseek": 4,
      "anthropic": 2,
      "openai": 2
    },
    "modelConcurrency": {
      "zhipuai-coding-plan/glm-4.7": 15,
      "zhipuai-coding-plan/glm-4.7-flash": 20,
      "google/gemini-3-flash-preview": 10,
      "minimax-cn-coding-plan/MiniMax-M2.5": 6,
      "github-copilot/gpt-4o": 6,
      "github-copilot/gpt-5-mini": 8,
      "github-copilot/claude-haiku-4.5": 6,
      "deepseek/deepseek-v3-2": 4,
      "anthropic/claude-haiku-4-5": 2,
      "openai/gpt-5.3-codex": 2
    }
  },
  "sisyphus_agent": {
    "disabled": false,
    "default_builder_enabled": false,
    "planner_enabled": true,
    "replace_plan": true
  },
  "git_master": {
    "commit_footer": true,
    "include_co_authored_by": true
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  },
  "disabled_mcps": ["github"]
}
