{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "description": "平衡型（直连优先）：关键推理/审查直连 Anthropic/OpenAI，Copilot 仅用于免费与高频通道",
  "metadata": {
    "version": "2.2.1-direct",
    "updated": "2026-02-13",
    "cost_level": "low",
    "use_case": "默认日常策略（直连 API 优先，适合生产环境）",
    "optimization": "直连高质量 + Copilot免费模型兜底",
    "monthly_cost": "¥400-700",
    "resources_used": [
      "ZhiPu CodingPlan Max (60倍) - GLM-5",
      "方舟 CodingPlan Pro (20倍)",
      "Anthropic Pro（主力）",
      "Google Pro",
      "OpenAI Plus（主力）",
      "GitHub Copilot Pro+（免费模型）"
    ],
    "scene_coverage": "79%",
    "scene_mapping": {
      "个人项目开发": "visual-engineering (OpenAI Codex)",
      "子女教育": "artistry (Anthropic Sonnet)",
      "公文处理": "quick (GPT-4o免费)",
      "健康管理": "deep (Anthropic Opus)",
      "AI项目探索": "visual-engineering + ultrabrain",
      "日常工具": "quick (免费)",
      "笔记管理": "unspecified-low (GLM-5高并发)",
      "娱乐": "quick (免费)",
      "常规写作": "writing (Anthropic Sonnet)",
      "多媒体创作": "artistry (Anthropic Sonnet)",
      "新媒体运营": "writing + artistry"
    }
  },
  // ================================================
  // Strategy-2: 平衡型 (BALANCED) - 直连优先
  // ================================================
  "agents": {
    "sisyphus": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "temperature": 0.3,
      "maxTokens": 4000,
      "description": "用 ZhiPu GLM-5 60倍额度作为主编排器"
    },
    "prometheus": {
      "model": "anthropic/claude-sonnet-4-6",
      "thinking": {
        "type": "enabled",
        "budgetTokens": 80000
      },
      "temperature": 0.2,
      "maxTokens": 4500,
      "description": "规划器保持高质量"
    },
    "oracle": {
      "model": "openai/gpt-5.3-codex",
      "fallback": "anthropic/claude-sonnet-4-6",
      "fallbackReason": "直连 Anthropic 备用 - 相同质量保证",
      "reasoningEffort": "medium",
      "temperature": 0.3,
      "maxTokens": 5000,
      "description": "关键架构决策（直连 OpenAI）"
    },
    "hephaestus": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "temperature": 0.3,
      "maxTokens": 4000,
      "description": "深度工作用大额度"
    },
    "librarian": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "temperature": 0.1,
      "maxTokens": 2500,
      "description": "快速查询用大额度"
    },
    "explore": {
      "model": "anthropic/claude-haiku-4-5",
      "temperature": 0.2,
      "maxTokens": 2000,
      "description": "轻量级探索"
    },
    "multimodal-looker": {
      "model": "google/gemini-3-flash-preview",
      "temperature": 0.3,
      "maxTokens": 3000,
      "description": "多模态用 Flash"
    },
    "metis": {
      "model": "anthropic/claude-sonnet-4-6",
      "thinking": {
        "type": "enabled",
        "budgetTokens": 50000
      },
      "temperature": 0.2,
      "maxTokens": 3500,
      "description": "规划前分析"
    },
    "momus": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "temperature": 0.2,
      "maxTokens": 3000,
      "description": "规划审查"
    },
    "atlas": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "temperature": 0.2,
      "maxTokens": 4000,
      "description": "执行器用大额度"
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "openai/gpt-5.3-codex",
      "reasoningEffort": "medium",
      "temperature": 0.3,
      "maxTokens": 4000,
      "description": "个人项目开发、AI探索 - 代码专精模型"
    },
    "ultrabrain": {
      "model": "anthropic/claude-opus-4-6",
      "variant": "max",
      "fallback": "github-copilot/gpt-5-mini",
      "fallbackReason": "直连 OpenAI 高性价比备选 - xhigh 质量",
      "thinking": {
        "type": "enabled",
        "budgetTokens": 80000
      },
      "temperature": 0.2,
      "maxTokens": 5000,
      "description": "复杂架构决策（直连 Opus）"
    },
    "artistry": {
      "model": "anthropic/claude-sonnet-4-6",
      "fallback": "google/gemini-3-pro-preview",
      "fallbackReason": "直连 Google 多模态备选 - 创意能力强",
      "temperature": 0.7,
      "maxTokens": 4500,
      "description": "子女教育、多媒体创作 - 温和耐心+创意",
      "systemPrompt": "在处理教育相关话题时，展现耐心和同理心，因材施教，关注心理健康。在创意内容时，发挥想象力和表达力。"
    },
    "quick": {
      "model": "github-copilot/gpt-4o",
      "temperature": 0.3,
      "maxTokens": 2000,
      "description": "公文处理、日常工具、娱乐 - 免费快速模型"
    },
    "unspecified-low": {
      "model": "zhipuai-coding-plan/glm-4.7",
      "temperature": 0.3,
      "maxTokens": 2500,
      "description": "文件编辑、代码清理"
    },
    "unspecified-high": {
      "model": "anthropic/claude-sonnet-4-6",
      "thinking": {
        "type": "enabled",
        "budgetTokens": 50000
      },
      "temperature": 0.3,
      "maxTokens": 5000,
      "description": "复杂功能实现、架构设计"
    },
    "writing": {
      "model": "anthropic/claude-sonnet-4-6",
      "temperature": 0.6,
      "maxTokens": 4000,
      "description": "个人写作、新媒体、技术文章 - 专业文笔"
    },
    "deep": {
      "model": "anthropic/claude-opus-4-6",
      "fallback": "openai/gpt-5.3-codex",
      "fallbackReason": "直连 OpenAI 备用 - 推理能力强",
      "thinking": {
        "type": "enabled",
        "budgetTokens": 120000
      },
      "temperature": 0.2,
      "maxTokens": 6000,
      "description": "健康管理、深度分析、重要决策 - 最强推理+专业提示",
      "systemPrompt": "在处理健康、金融等敏感领域时，务必：1) 明确你的局限性 2) 建议咨询专业人士 3) 提供多种可能性和风险评估 4) 保持审慎和负责的态度。"
    }
  },
  "background_task": {
    "defaultConcurrency": 12,
    "staleTimeoutMs": 300000,
    "providerConcurrency": {
      "anthropic": 3,
      "openai": 3,
      "google": 5,
      "zhipuai-coding-plan": 25,
      "github-copilot": 6
    },
    "modelConcurrency": {
      "anthropic/claude-opus-4-6": 1,
      "anthropic/claude-sonnet-4-6": 2,
      "anthropic/claude-haiku-4-5": 4,
      "google/gemini-3-pro-preview": 3,
      "google/gemini-3-flash-preview": 10,
      "openai/gpt-5.3-codex": 2,
      "zhipuai-coding-plan/glm-4.7": 30,
      "github-copilot/gpt-4o": 10
    }
  },
  "sisyphus_agent": {
    "disabled": false,
    "default_builder_enabled": false,
    "planner_enabled": true,
    "replace_plan": true
  },
  "git_master": {
    "commit_footer": true,
    "include_co_authored_by": true
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  },
  "experimental": {
    "aggressive_truncation": false,
    "auto_resume": true,
    "truncate_all_tool_outputs": false
  },
  "disabled_mcps": ["github"],
  "disabled_hooks": []
}
