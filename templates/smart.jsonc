{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "description": "旗舰智能策略：最强模型组合，处理最复杂任务，不差钱",
  "metadata": {
    "version": "3.0.0",
    "updated": "2026-02-25",
    "cost_level": "high",
    "use_case": "关键项目、复杂架构设计、深度推理任务",
    "optimization": "全平台顶级模型互为兜底，发挥已订阅最高级 API 能力",
    "monthly_cost": "¥2000-3000 (主要消耗订阅额度)",
    "resources_used": [
      "GitHub Copilot Pro+",
      "Anthropic Pro",
      "OpenAI Plus",
      "Google Pro",
      "ZhiPu CodingPlan Pro (GLM-5)",
      "方舟 CodingPlan Pro",
      "MiniMax Coding Plan Pro",
      "DeepSeek API",
      "硅基流动",
      "OpenRouter"
    ]
  },
  "lsp": {
    "scene_coverage": ["core development", "architecture design", "code review", "research", "creative", "writing", "multimedia", "collaboration", "education", "documentation", "agent-heavy"],
    "budget": {
      "monthlyLimitUSD": 3000,
      "dailyAlertThreshold": 0.8,
      "emergencySwitchTo": "balanced"
    },
    "provider_quotas": {
      "anthropic": {
        "priority": 1,
        "maxRequestsPerDay": 10000,
        "maxConcurrentRequests": 10,
        "fallbackModels": ["openai/gpt-5.2", "google/gemini-3-pro-preview"]
      },
      "openai": {
        "priority": 1,
        "maxRequestsPerDay": 10000,
        "maxConcurrentRequests": 10,
        "fallbackModels": ["anthropic/claude-opus-4-6", "deepseek/deepseek-v3-2"]
      },
      "google": {
        "priority": 1,
        "maxRequestsPerDay": 8000,
        "maxConcurrentRequests": 15,
        "fallbackModels": ["openai/gpt-5.2", "deepseek/deepseek-v3-2"]
      },
      "github-copilot": {
        "priority": 1,
        "maxRequestsPerDay": 100000,
        "maxConcurrentRequests": 50
      },
      "zhipuai-coding-plan": {
        "priority": 2,
        "maxRequestsPerDay": 50000,
        "maxConcurrentRequests": 30,
        "fallbackModels": ["deepseek/deepseek-v3-2", "minimax-cn-coding-plan/MiniMax-M2.5"]
      },
      "minimax-cn-coding-plan": {
        "priority": 2,
        "maxRequestsPerDay": 50000,
        "maxConcurrentRequests": 30
      },
      "ark": {
        "priority": 2,
        "maxRequestsPerDay": 20000,
        "maxConcurrentRequests": 20
      },
      "deepseek": {
        "priority": 3,
        "maxRequestsPerDay": 20000,
        "maxConcurrentRequests": 20,
        "fallbackModels": ["zhipuai-coding-plan/glm-5"]
      },
      "siliconflow": {
        "priority": 3,
        "maxRequestsPerDay": 10000,
        "maxConcurrentRequests": 20
      },
      "openrouter": {
        "priority": 4,
        "maxRequestsPerDay": 5000,
        "maxConcurrentRequests": 10
      }
    },
    "constraints": {
      "maxToolsPerRequest": 15,
      "allowedTools": ["web_search", "file_io", "code_generation", "shell_execution", "data_processing", "git_operations"]
    }
  },
  "agents": {
    "sisyphus": {
      "model": "github-copilot/claude-opus-4.6",
      "fallback": ["anthropic/claude-opus-4-6", "minimax-cn-coding-plan/MiniMax-M2.5", "ark/doubao-1.5-pro", "deepseek/deepseek-v3-2", "siliconflow/deepseek-v3", "openrouter/deepseek/deepseek-chat-v3"],
      "thinking": {
        "type": "enabled",
        "budgetTokens": 200000
      },
      "temperature": 0.6,
      "maxTokens": 8000
    },
    "prometheus": {
      "model": "openai/gpt-5.3-codex",
      "fallback": ["google/antigravity-claude-opus-4-6-thinking", "github-copilot/gpt-5-mini"],
      "thinking": {
        "type": "enabled",
        "budgetTokens": 150000
      },
      "temperature": 0.55,
      "maxTokens": 6000
    },
    "oracle": {
      "model": "openai/gpt-5.3-codex",
      "fallback": ["anthropic/claude-opus-4-6", "zhipuai-coding-plan/glm-5"],
      "temperature": 0.55,
      "maxTokens": 6000
    },
    "hephaestus": {
      "model": "openai/gpt-5.3-codex",
      "fallback": ["github-copilot/claude-opus-4.6", "minimax-cn-coding-plan/MiniMax-M2.5"],
      "temperature": 0.55,
      "maxTokens": 8000
    },
    "multimodal-looker": {
      "model": "google/gemini-3-pro-preview",
      "fallback": ["github-copilot/gpt-4o"],
      "temperature": 0.5,
      "maxTokens": 4000
    },
    "metis": {
      "model": "anthropic/claude-sonnet-4-6",
      "fallback": ["github-copilot/claude-sonnet-4.6"],
      "thinking": {
        "type": "enabled",
        "budgetTokens": 80000
      },
      "temperature": 0.55,
      "maxTokens": 4000
    },
    "momus": {
      "model": "openai/gpt-5.3-codex",
      "fallback": ["anthropic/claude-sonnet-4-6"],
      "temperature": 0.5,
      "maxTokens": 5000
    },
    "librarian": {
      "model": "anthropic/claude-sonnet-4-6",
      "fallback": ["github-copilot/gpt-4o"],
      "temperature": 0.4,
      "maxTokens": 6000
    },
    "explore": {
      "model": "anthropic/claude-haiku-4-5",
      "fallback": ["zhipuai-coding-plan/glm-5"],
      "temperature": 0.3,
      "maxTokens": 4000
    },
    "fast-writer": {
      "model": "anthropic/claude-sonnet-4-6",
      "fallback": ["google/gemini-3-pro-preview"],
      "temperature": 0.6,
      "maxTokens": 8000
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "anthropic/claude-sonnet-4-6",
      "temperature": 0.5,
      "maxTokens": 5000
    },
    "ultrabrain": {
      "model": "anthropic/claude-opus-4-6",
      "thinking": {
        "type": "enabled",
        "budgetTokens": 200000
      },
      "temperature": 0.5,
      "maxTokens": 8000
    },
    "deep": {
      "model": "anthropic/claude-opus-4-6",
      "thinking": {
        "type": "enabled",
        "budgetTokens": 80000
      },
      "temperature": 0.5,
      "maxTokens": 6000
    },
    "artistry": {
      "model": "google/gemini-3-pro-preview",
      "temperature": 0.8,
      "maxTokens": 6000
    },
    "quick": {
      "model": "anthropic/claude-haiku-4-5",
      "temperature": 0.3,
      "maxTokens": 3000
    },
    "unspecified-low": {
      "model": "anthropic/claude-haiku-4-5",
      "temperature": 0.4,
      "maxTokens": 4000
    },
    "unspecified-high": {
      "model": "anthropic/claude-sonnet-4-6",
      "thinking": {
        "type": "enabled",
        "budgetTokens": 40000
      },
      "temperature": 0.5,
      "maxTokens": 5000
    },
    "writing": {
      "model": "anthropic/claude-sonnet-4-6",
      "temperature": 0.6,
      "maxTokens": 5000
    }
  },
  "background_task": {
    "defaultConcurrency": 25,
    "staleTimeoutMs": 300000,
    "providerConcurrency": {
      "github-copilot": 25,
      "openai": 15,
      "anthropic": 15,
      "google": 20
    }
  },
  "sisyphus_agent": {
    "disabled": false,
    "default_builder_enabled": false,
    "planner_enabled": true,
    "replace_plan": true
  },
  "git_master": {
    "commit_footer": true,
    "include_co_authored_by": true
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  },
  "experimental": {
    "aggressive_truncation": false,
    "auto_resume": true,
    "truncate_all_tool_outputs": false
  },
  "disabled_mcps": [
    "github"
  ]
}