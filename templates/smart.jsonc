{
  // "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "description": "旗舰智能策略：最强模型组合，处理最复杂任务，不差钱",
  // "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "description": "旗舰智能策略：最强模型组合，处理最复杂任务，不差钱",
  "metadata": {
    "version": "2.1.1",
    "updated": "2026-02-13",
    "cost_level": "high",
    "use_case": "关键项目、复杂架构设计、深度推理任务",
    "optimization": "最高性能优先，不考虑成本",
    "monthly_cost": "¥2000-3000",
    "resources_used": [
      "GitHub Copilot Pro+",
      "Anthropic Pro",
      "OpenAI Plus",
      "Google Pro",
      "ZhiPu CodingPlan Max (GLM-5)",
      "方舟 CodingPlan Pro"
    ]
  },

  "lsp": {
    "scene_coverage": ["core development", "architecture design", "code review", "research", "creative", "writing", "multimedia", "collaboration", "education", "documentation", "agent-heavy"]
    "budget": {
      "monthlyLimitUSD": 3000,
      "dailyAlertThreshold": 0.8,
      "emergencySwitchTo": "performance"
    },
    "provider_quotas": {
      "anthropic": {
        "priority": 1,
        "maxRequestsPerDay": 10000,
        "maxCostPerRequest": 0.05,
        "maxConcurrentRequests": 10,
        "fallbackModels": ["openai/gpt-5.2", "google/gemini-3-pro-preview"]
      },
      "openai": {
        "priority": 1,
        "maxRequestsPerDay": 10000,
        "maxCostPerRequest": 0.05,
        "maxConcurrentRequests": 10,
        "fallbackModels": ["anthropic/claude-opus-4-6", "deepseek/deepseek-v3-2"]
      },
      "google": {
        "priority": 2,
        "maxRequestsPerDay": 8000,
        "maxCostPerRequest": 0.03,
        "maxConcurrentRequests": 15,
        "fallbackModels": ["openai/gpt-5.2", "deepseek/deepseek-v3-2"]
      },
      "deepseek": {
        "priority": 2,
        "maxRequestsPerDay": 20000,
        "maxCostPerRequest": 0.01,
        "maxConcurrentRequests": 20,
        "fallbackModels": ["openai/gpt-5.2", "zhipuai/glm-5"]
      },
      "zhipuai": {
        "priority": 3,
        "maxRequestsPerDay": 50000,
        "maxCostPerRequest": 0.005,
        "maxConcurrentRequests": 30,
        "fallbackModels": ["deepseek/deepseek-v3-2", "kimi/kimi-coding-pro"]
      },
      "kimi": {
        "priority": 4
      },
      "step": {
        "priority": 4
      },
      "minimax": {
        "priority": 4
      },
      "github-copilot": {
        "priority": 1,
        "maxRequestsPerDay": 10000,
        "maxConcurrentRequests": 5
      }
      "anthropic": {
        "priority": 1
      },
      "openai": {
        "priority": 1
      },
      "kimi": {
        "priority": 3
      },
      "step": {
        "priority": 4
      }
    },
    "constraints": {
      "maxToolsPerRequest": 15
    }
  },
  // ================================================
  // Strategy-SMART: 旗舰智能
  // ================================================
  // 理念：用最强的模型做最重要的事，充分利用思考预算
  // 关键特性：
  //   1. Sisyphus 用 Opus 4.6，完整思考支持
  //   2. 规划器用 Opus 4.6 (Antigravity)，思考预算充足
  //   3. 架构评审用 GPT-5.3-Codex 高级推理
  //   4. 快速任务用 ZhiPu GLM-5（60倍额度）
  //   5. 严格并发控制，避免超限
  // ================================================
  // ========== Agent 配置 ==========
  "agents": {
    // 主编排器 - Claude Opus 4.6 (Anthropic/GitHub Copilot)
    // 职责：任务规划、多agent协调、最终决策
    // 配置：完整思考支持，高预算用于复杂推理
    "sisyphus": {
      "model": "github-copilot/claude-opus-4.6",
      "fallback": ["anthropic/claude-opus-4-6", "minimax-cn-coding-plan/MiniMax-M2.5", "ark/glm-5", "deepseek/deepseek-v3-2", "siliconflow/deepseek-v3", "openrouter/deepseek/deepseek-chat-v3"],
      "fallbackReason": "极致稳定 - Anthropic Opus 4.6 互备",
      "variant": "max",
      "thinking": {
        "type": "enabled",
        "budgetTokens": 200000
      },
      "temperature": 0.6,
      "maxTokens": 8000
    },
    // 规划器 - Claude Opus 4.6 Thinking (Google Antigravity)
    // 职责：战略规划、需求分析、工作流设计
    // 配置：通过 Antigravity 访问，充足思考预算
    "prometheus": {
      "model": "openai/gpt-5.3-codex",
      "fallback": "google/antigravity-claude-opus-4-6-thinking",
      "fallbackReason": "极致稳定 - GPT-5.3-Codex 高级推理互备",
      "variant": "max",
      "thinking": {
        "type": "enabled",
        "budgetTokens": 150000
      },
      "temperature": 0.55,
      "maxTokens": 6000
    },
    // 架构/代码审查 - GPT-5.3-Codex
    // 职责：架构决策、代码审查、设计模式评估
    // 配置：xhigh 推理能力
    "oracle": {
      "model": "openai/gpt-5.3-codex",
      "fallback": "anthropic/claude-opus-4-6",
      "fallbackReason": "极致稳定 - Opus 4.6 高级推理互备",
      "reasoningEffort": "xhigh",
      "temperature": 0.55,
      "maxTokens": 6000
    },
    // 深度工作者 - GPT-5.3-Codex
    // 职责：自主完成复杂开发任务，执行细节实现
    "hephaestus": {
      "model": "openai/gpt-5.3-codex",
      "fallback": "github-copilot/claude-opus-4.6",
      "fallbackReason": "极致稳定 - Copilot Opus 4.6 高级互备",
      "reasoningEffort": "high",
      "temperature": 0.55,
      "maxTokens": 8000
    },
    // 文档/知识查询 - GLM-4.7 (ZhiPu 60倍额度)
    // 职责：快速查询、文档检索、模式匹配
    // 配置：低温度、低成本、高并发

    // 快速探索 - Claude Haiku 4.5
    // 职责：快速代码探索、grep 上下文收集
    // 配置：经济型，用于辅助任务

    // 多模态分析 - Gemini 3 Pro
    // 职责：图像分析、UI 评审、多模态任务
    // 配置：高变体用于最佳质量
    "multimodal-looker": {
      "model": "google/gemini-3-pro-preview",
      "fallback": "google/gemini-3-flash-preview",
      "fallbackReason": "极致稳定 - Gemini Flash 3 多模态互备",
      "variant": "high",
      "temperature": 0.5,
      "maxTokens": 4000
    },
    // 规划前分析 - Claude Sonnet 4.5 Thinking
    // 职责：需求歧义识别、AI失败点分析
    "metis": {
      "model": "anthropic/claude-sonnet-4-6",
      "fallback": "github-copilot/claude-sonnet-4.6",
      "fallbackReason": "极致稳定 - Sonnet 4.5 思考互备",
      "thinking": {
        "type": "enabled",
        "budgetTokens": 80000
      },
      "temperature": 0.55,
      "maxTokens": 4000
    },
    // 规划审查 - GPT-5.3-Codex
    // 职责：计划验证、完整性检查、可验证性评估
    "momus": {
      "model": "openai/gpt-5.3-codex",
      "fallback": "anthropic/claude-opus-4-6",
      "fallbackReason": "极致稳定 - Opus 4.6 审查互备",
      "reasoningEffort": "medium",
      "temperature": 0.55,
      "maxTokens": 4000
    },
    // 深度思考 - Claude Opus 4.6 Thinking (Github Copilot)
    // 职责：复杂问题的深度分析和思考
    "atlas": {
      "model": "github-copilot/claude-opus-4.6",
      "fallback": "anthropic/claude-opus-4-6",
      "fallbackReason": "极致稳定 - Anthropic Opus 4.6 互备",
      "thinking": {
        "type": "enabled",
        "budgetTokens": 150000
      },
      "temperature": 0.55,
      "maxTokens": 6000
    }
  },
  // ========== Category 配置 ==========
  "categories": {
    // 前端 UI/UX 设计

    // 深度逻辑推理
    "ultrabrain": {
      "model": "openai/gpt-5.3-codex",
      "fallback": "anthropic/claude-opus-4-6",
      "fallbackReason": "极致稳定 - Opus 4.6 超强推理互备",
      "variant": "xhigh",
      "reasoningEffort": "xhigh",
      "temperature": 0.2,
      "maxTokens": 8000,
      "description": "复杂架构决策、深度逻辑推理、算法设计"
    },
    // 创意任务
    "artistry": {
      "model": "google/gemini-3-pro-preview",
      "fallback": "anthropic/claude-sonnet-4-6",
      "fallbackReason": "极致稳定 - Sonnet 4.5 创意互备",
      "variant": "max",
      "temperature": 0.7,
      "maxTokens": 6000,
      "description": "创意文案、设计创意、新颖想法生成"
    },

    // 通用高难度
    "unspecified-high": {
      "model": "anthropic/claude-opus-4-6",
      "fallback": "github-copilot/claude-opus-4.6",
      "fallbackReason": "极致稳定 - Copilot Opus 4.6 互备",
      "variant": "max",
      "thinking": {
        "type": "enabled",
        "budgetTokens": 100000
      },
      "temperature": 0.3,
      "maxTokens": 8000,
      "description": "复杂功能实现、架构设计、系统优化",
    },
    // 文档/技术写作
    "writing": {
      "model": "github-copilot/claude-sonnet-4.6",
      "temperature": 0.6,
      "maxTokens": 5000,
      "description": "文档编写、技术文章、API 文档"
    },
    // 深度分析
    "deep": {
      "model": "openai/gpt-5.3-codex",
      "fallback": "anthropic/claude-opus-4-6",
      "fallbackReason": "极致稳定 - Opus 4.6 深度分析互备",
      "reasoningEffort": "xhigh",
      "temperature": 0.2,
      "maxTokens": 8000,
      "description": "系统分析、性能优化、问题诊断"
    }
  },
  // ========== 并发控制 ==========
  "background_task": {
    "defaultConcurrency": 5,
    "staleTimeoutMs": 300000,
    // Provider 级别并发限制
    "providerConcurrency": {
      "anthropic": 3,
      "openai": 3,
      "google": 5,
      "zhipuai-coding-plan": 15,
      "github-copilot": 2
    },
    // 模型级别并发限制（优先级更高）
    "modelConcurrency": {
      "anthropic/claude-opus-4-6": 2,
      "anthropic/claude-sonnet-4-6": 2,
      "anthropic/claude-haiku-4-5": 5,
      "github-copilot/claude-opus-4.6": 2,
      "github-copilot/claude-sonnet-4.6": 2,
      "github-copilot/claude-haiku-4.5": 5,
      "google/antigravity-claude-opus-4-6-thinking": 2,
      "google/gemini-3-pro-preview": 4,
      "google/gemini-3-flash-preview": 8,
      "openai/gpt-5.3-codex": 2,
      "zhipuai-coding-plan/glm-4.7": 20
    }
  },
  // ========== Sisyphus Agent 配置 ==========
  "sisyphus_agent": {
    "disabled": false,
    "default_builder_enabled": false,
    "planner_enabled": true,
    "replace_plan": true
  },
  // ========== Git 配置 ==========
  "git_master": {
    "commit_footer": true,
    "include_co_authored_by": true
  },
  // ========== Tmux 集成 ==========
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  },
  // ========== 实验性功能 ==========
  "experimental": {
    "aggressive_truncation": false,
    "auto_resume": true,
    "truncate_all_tool_outputs": false,
    "dynamic_context_pruning": {
      "enabled": false
    }
  },
  // ========== MCP 配置 ==========
  "disabled_mcps": ["github"],
  // ========== Hooks 配置 ==========
  "disabled_hooks": []
}
