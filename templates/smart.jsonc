{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "description": "旗舰智能型：复杂任务优先，顶级模型互备并最大化资源可用性",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 2000
  },
  "metadata": {
    "version": "3.3.0",
    "updated": "2026-02-27",
    "cost_level": "high",
    "use_case": "架构设计、复杂重构、深度推理、多模型协作",
    "optimization": "Anthropic/OpenAI/Google 高质量主线 + 国产Pro与DeepSeek做容量与推理托底",
    "monthly_cost": "¥300-1800 (随强度波动)",
    "resources_used": [
      "Anthropic Pro",
      "ChatGPT Plus/Pro",
      "Google Pro 双账号",
      "GitHub Copilot Pro+",
      "DeepSeek 余额",
      "Kimi/MiniMax/ZhiPu/Bailian/Volcengine Pro"
    ]
  },
  "claude_code": {
    "skills": false,
    "mcp": false,
    "plugins": false,
    "hooks": false,
    "commands": false,
    "agents": false
  },
  "lsp": {
    "scene_coverage": [
      "core development",
      "architecture design",
      "code review",
      "research",
      "creative",
      "multimodal",
      "agent-heavy"
    ],
    "budget": {
      "monthlyLimitUSD": 2500,
      "dailyAlertThreshold": 0.93,
      "emergencySwitchTo": "balanced"
    },
    "provider_quotas": {
      "anthropic": {
        "priority": 1,
        "maxRequestsPerDay": 520,
        "maxConcurrentRequests": 16,
        "fallbackModels": [
          "anthropic/claude-opus-4-6",
          "anthropic/claude-sonnet-4-6"
        ]
      },
      "openai": {
        "priority": 1,
        "maxRequestsPerDay": 520,
        "maxConcurrentRequests": 16,
        "fallbackModels": [
          "openai/gpt-5.3-codex",
          "openai/gpt-5.2-codex"
        ]
      },
      "google": {
        "priority": 1,
        "maxRequestsPerDay": 760,
        "maxConcurrentRequests": 24,
        "fallbackModels": [
          "google/antigravity-gemini-3.1-pro",
          "google/antigravity-claude-sonnet-4-6-thinking"
        ]
      },
      "github-copilot": {
        "priority": 2,
        "maxRequestsPerDay": 520,
        "maxConcurrentRequests": 18,
        "fallbackModels": [
          "github-copilot/gpt-4o",
          "github-copilot/gpt-4.1",
          "github-copilot/gpt-5-mini"
        ]
      },
      "deepseek": {
        "priority": 2,
        "maxRequestsPerDay": 560,
        "maxConcurrentRequests": 20,
        "fallbackModels": [
          "deepseek/deepseek-reasoner",
          "deepseek/deepseek-chat"
        ]
      },
      "bailian-coding-plan": {
        "priority": 2,
        "maxRequestsPerDay": 460,
        "maxConcurrentRequests": 16,
        "fallbackModels": [
          "bailian-coding-plan/qwen3-max-2026-01-23",
          "bailian-coding-plan/qwen3.5-plus"
        ]
      },
      "zhipuai-coding-plan": {
        "priority": 2,
        "maxRequestsPerDay": 500,
        "maxConcurrentRequests": 16,
        "fallbackModels": [
          "zhipuai-coding-plan/glm-5",
          "zhipuai-coding-plan/glm-4.7"
        ]
      },
      "minimax-coding-plan": {
        "priority": 2,
        "maxRequestsPerDay": 480,
        "maxConcurrentRequests": 18,
        "fallbackModels": [
          "minimax-coding-plan/MiniMax-M2.5"
        ]
      },
      "kimi-coding-plan": {
        "priority": 2,
        "maxRequestsPerDay": 480,
        "maxConcurrentRequests": 18,
        "fallbackModels": [
          "kimi-coding-plan/kimi-for-coding"
        ]
      },
      "volcegine-coding-plan": {
        "priority": 3,
        "maxRequestsPerDay": 400,
        "maxConcurrentRequests": 14,
        "fallbackModels": [
          "volcegine-coding-plan/doubao-seed-2-0-code-preview-latest"
        ]
      }
    },
    "constraints": {
      "maxToolsPerRequest": 20,
      "allowedTools": [
        "web_search",
        "file_io",
        "code_generation",
        "shell_execution",
        "data_processing",
        "git_operations"
      ]
    }
  },
  "agents": {
    "sisyphus": {
      "model": "anthropic/claude-opus-4-6",
      "fallback": [
        "openai/gpt-5.3-codex",
        "github-copilot/claude-opus-4.6",
        "google/antigravity-claude-sonnet-4-6-thinking"
      ],
      "thinking": {
        "type": "enabled",
        "budgetTokens": 120000
      }
    },
    "sisyphus-junior": {
      "model": "anthropic/claude-sonnet-4-6",
      "fallback": [
        "openai/gpt-5.2-codex",
        "google/antigravity-gemini-3.1-pro",
        "github-copilot/claude-sonnet-4.6"
      ],
      "thinking": {
        "type": "enabled",
        "budgetTokens": 40000
      },
      "temperature": 0.35
    },
    "prometheus": {
      "model": "openai/gpt-5.3-codex",
      "fallback": [
        "anthropic/claude-sonnet-4-6",
        "github-copilot/gpt-5.3-codex"
      ],
      "thinking": {
        "type": "enabled",
        "budgetTokens": 96000
      }
    },
    "oracle": {
      "model": "google/antigravity-claude-sonnet-4-6-thinking",
      "fallback": [
        "anthropic/claude-sonnet-4-6",
        "google/antigravity-gemini-3.1-pro",
        "openai/gpt-5.2-codex"
      ]
    },
    "hephaestus": {
      "model": "openai/gpt-5.3-codex",
      "fallback": [
        "github-copilot/gpt-5.2-codex",
        "anthropic/claude-sonnet-4-6"
      ]
    },
    "multimodal-looker": {
      "model": "google/antigravity-gemini-3.1-pro",
      "fallback": [
        "google/antigravity-gemini-3-flash",
        "github-copilot/gpt-4o"
      ]
    },
    "metis": {
      "model": "deepseek/deepseek-reasoner",
      "fallback": [
        "anthropic/claude-sonnet-4-6",
        "zhipuai-coding-plan/glm-5",
        "openai/gpt-5.2-codex"
      ]
    },
    "momus": {
      "model": "bailian-coding-plan/qwen3-max-2026-01-23",
      "fallback": [
        "zhipuai-coding-plan/glm-5",
        "volcegine-coding-plan/doubao-seed-2-0-code-preview-latest"
      ]
    },
    "librarian": {
      "model": "kimi-coding-plan/kimi-for-coding",
      "fallback": [
        "anthropic/claude-sonnet-4-6"
      ]
    },
    "explore": {
      "model": "google/antigravity-gemini-3.1-pro",
      "fallback": [
        "deepseek/deepseek-chat"
      ]
    },
    "atlas": {
      "model": "minimax-coding-plan/MiniMax-M2.5",
      "fallback": [
        "zhipuai-coding-plan/glm-5"
      ]
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "google/antigravity-gemini-3.1-pro"
    },
    "ultrabrain": {
      "model": "anthropic/claude-opus-4-6",
      "fallback": [
        "openai/gpt-5.3-codex"
      ]
    },
    "deep": {
      "model": "deepseek/deepseek-reasoner",
      "fallback": [
        "anthropic/claude-sonnet-4-6",
        "openai/gpt-5.3-codex"
      ]
    },
    "artistry": {
      "model": "google/antigravity-gemini-3.1-pro",
      "fallback": [
        "google/antigravity-gemini-3-flash"
      ],
      "temperature": 0.8
    },
    "quick": {
      "model": "github-copilot/gpt-5-mini",
      "fallback": [
        "github-copilot/gpt-4.1"
      ]
    },
    "unspecified-low": {
      "model": "github-copilot/gpt-4.1"
    },
    "unspecified-high": {
      "model": "anthropic/claude-sonnet-4-6",
      "fallback": [
        "openai/gpt-5.3-codex"
      ]
    },
    "writing": {
      "model": "google/antigravity-gemini-3.1-pro",
      "fallback": [
        "anthropic/claude-sonnet-4-6",
        "kimi-coding-plan/kimi-for-coding"
      ],
      "temperature": 0.7
    }
  }
}
