{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "description": "旗舰智能策略：结合顶级订阅API与国产头部模型，专攻复杂项目与深度创意任务，不差钱",
  "metadata": {
    "version": "3.1.0",
    "updated": "2026-02-25",
    "cost_level": "high",
    "use_case": "关键项目、复杂架构设计、深度推理任务、文学创作与前沿探索",
    "optimization": "全平台顶级模型互为兜底，集成 Qwen-Max、Gemini 3.1 Pro、DeepSeek R1、Doubao Seed Code",
    "monthly_cost": "¥2000-3000 (主要消耗订阅额度与高优先级 API)",
    "resources_used": [
      "GitHub Copilot Pro+",
      "Anthropic Pro",
      "OpenAI Plus",
      "Google Pro (Gemini 3.1)",
      "DashScope (Qwen Max)",
      "方舟 CodingPlan Pro (Doubao Seed Code)",
      "MiniMax Coding Plan Pro",
      "Kimi Coding Plan Pro",
      "ZhiPu CodingPlan Pro (GLM-5)",
      "DeepSeek API / SiliconFlow"
    ]
  },
  "claude_code": {
    "skills": false
  },
  "lsp": {
    "scene_coverage": [
      "core development",
      "architecture design",
      "code review",
      "research",
      "creative",
      "writing",
      "multimedia",
      "collaboration",
      "education",
      "documentation",
      "agent-heavy"
    ],
    "budget": {
      "monthlyLimitUSD": 3000,
      "dailyAlertThreshold": 0.8,
      "emergencySwitchTo": "balanced"
    },
    "provider_quotas": {
      "anthropic": {
        "priority": 1,
        "maxRequestsPerDay": 10000,
        "maxConcurrentRequests": 10,
        "fallbackModels": [
          "openai/gpt-5.2",
          "google/gemini-3.1-pro-preview"
        ]
      },
      "openai": {
        "priority": 1,
        "maxRequestsPerDay": 10000,
        "maxConcurrentRequests": 10,
        "fallbackModels": [
          "anthropic/claude-opus-4-6",
          "deepseek/deepseek-v3-2"
        ]
      },
      "google": {
        "priority": 1,
        "maxRequestsPerDay": 15000,
        "maxCostPerRequest": 0.03,
        "maxConcurrentRequests": 20,
        "fallbackModels": [
          "openai/gpt-5.2",
          "dashscope/qwen-max-latest"
        ]
      },
      "github-copilot": {
        "priority": 1,
        "maxRequestsPerDay": 100000,
        "maxConcurrentRequests": 50
      },
      "dashscope": {
        "priority": 2,
        "maxRequestsPerDay": 20000,
        "maxConcurrentRequests": 20,
        "fallbackModels": [
          "ark-cn/Kimi-K2-thinking"
        ]
      },
      "ark-cn": {
        "priority": 2,
        "maxRequestsPerDay": 20000,
        "maxConcurrentRequests": 20
      },
      "minimax-cn-coding-plan": {
        "priority": 2,
        "maxRequestsPerDay": 50000,
        "maxConcurrentRequests": 30
      },
      "kimi": {
        "priority": 2,
        "maxRequestsPerDay": 50000,
        "maxConcurrentRequests": 30
      },
      "zhipuai-coding-plan": {
        "priority": 2,
        "maxRequestsPerDay": 20000,
        "maxConcurrentRequests": 20,
        "fallbackModels": [
          "minimax-cn-coding-plan/MiniMax-M2.5"
        ]
      },
      "siliconflow": {
        "priority": 3,
        "maxRequestsPerDay": 10000,
        "maxConcurrentRequests": 20
      },
      "deepseek": {
        "priority": 3,
        "maxRequestsPerDay": 20000,
        "maxConcurrentRequests": 20,
        "fallbackModels": [
          "dashscope/qwen-max-latest"
        ]
      }
    },
    "constraints": {
      "maxToolsPerRequest": 15,
      "allowedTools": [
        "web_search",
        "file_io",
        "code_generation",
        "shell_execution",
        "data_processing",
        "git_operations"
      ]
    }
  },
  "agents": {
    "sisyphus": {
      "model": "github-copilot/claude-opus-4.6",
      "fallback": [
        "anthropic/claude-opus-4-6",
        "dashscope/qwen-max-latest",
        "ark-cn/Doubao-Seed-2.0-Code",
        "siliconflow/deepseek-ai/DeepSeek-V3"
      ],
      "thinking": {
        "type": "enabled",
        "budgetTokens": 200000
      },
      "temperature": 0.6,
      "maxTokens": 8000
    },
    "prometheus": {
      "model": "openai/gpt-5.1-codex-max",
      "fallback": [
        "github-copilot/claude-3.5-sonnet",
