{
  "name": "@starlink-awaken/strategy-manager",
  "version": "3.0.0",
  "description": "AI策略配置生命周期管理工具 - OpenCode Skill for managing AI model configurations",
  "scripts": {
    "type-check": "tsc --noEmit",
    "dev:watch": "bun --watch Tools/ManageStrategies.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:unit": "bun test tests/unit/",
    "test:pathmanager": "bun test tests/unit/PathManager.test.ts",
    "test:validator": "bun test tests/unit/Validator.test.ts",
    "test:recommender": "bun test tests/unit/Recommender.test.ts",
    "test:ci": "bun test --coverage --reporter=junit"
  },
  "keywords": [
    "opencode",
    "skill",
    "ai",
    "strategy",
    "configuration",
    "management",
    "claude",
    "copilot",
    "gemini",
    "openai",
    "workflow",
    "typescript",
    "bun"
  ],
  "author": "starlink-awaken",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/starlink-awaken/StrategyManager.git"
  },
  "bugs": {
    "url": "https://github.com/starlink-awaken/StrategyManager/issues"
  },
  "homepage": "https://github.com/starlink-awaken/StrategyManager#readme",
  "files": [
    "Tools",
    "Workflows",
    "templates",
    "scripts",
    "SKILL.md",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
